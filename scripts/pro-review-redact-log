#!/usr/bin/env python3
"""Redact high-risk secrets from pro-review daemon logs."""
import re
import sys

PATTERNS = [
    (re.compile(r"(CONTROL_PLANE_API_KEY(?:_[A-Z0-9]+)?\s*=\s*)[^\s]+"), r"\1<REDACTED>"),
    (re.compile(r"sk-[A-Za-z0-9_-]{8,}"), "sk-<REDACTED>"),
    (re.compile(r"(?i)((?:cookie|cookies)[^:=\n]*[:=]\s*)[^\s]+"), r"\1<REDACTED>"),
]


def redact(text):
    for pattern, repl in PATTERNS:
        text = pattern.sub(repl, text)
    return text


def main():
    for line in sys.stdin:
        sys.stdout.write(redact(line))


if __name__ == "__main__":
    main()
