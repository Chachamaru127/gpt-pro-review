#!/usr/bin/env bash
# OpenAI Secure MCP Tunnel を pro-review 用に起動するラッパー。
# 前提: tunnel-client バイナリ(Platform Tunnels からDL) が PATH か ~/.pro-review/bin にある。
#       環境変数 CONTROL_PLANE_TUNNEL_ID, CONTROL_PLANE_API_KEY が設定済み。
set -euo pipefail

PROFILE="pro-review"
MCP_CMD="${PRO_REVIEW_MCP_CMD:-${PRO_REVIEW_SCRIPTS_DIR:-$HOME/.claude/skills/gpt-pro-review/scripts}/pro-review-mcp}"
export PATH="$HOME/.pro-review/bin:$PATH"
export HEALTH_LISTEN_ADDR="${HEALTH_LISTEN_ADDR:-127.0.0.1:0}"
export HEALTH_URL_FILE="${HEALTH_URL_FILE:-$HOME/.pro-review/health.url}"

_strip_env_value() {
  local v="$1"
  v="${v%\"}"
  v="${v#\"}"
  printf '%s' "$v"
}

_env_key_from_line() {
  local line="$1"
  line="${line#export }"
  printf '%s' "${line%%=*}"
}

_env_val_from_line() {
  local line="$1"
  line="${line#export }"
  _strip_env_value "${line#*=}"
}

_profile_suffix_valid() {
  case "$1" in
    ''|*[!A-Z0-9]*) return 1;;
    *) return 0;;
  esac
}

_resolved_auth_profile="default"
_resolved_tunnel_id=""
_resolved_org_header="no"

_report_tunnel_auth() {
  local tid_prefix="${_resolved_tunnel_id:0:12}"
  echo "[tunnel] profile=${_resolved_auth_profile} tunnel_id=${tid_prefix}… org_header=${_resolved_org_header}" >&2
}

_extra_headers_has_org() {
  case "${1:-}" in
    *OpenAI-Organization*) return 0;;
    *) return 1;;
  esac
}

# 認証情報を取り込む。source せず KEY=VALUE だけ parse（env.sh 改ざんでの任意コマンド実行を防ぐ）
_file_tunnel_profile=""
_file_tunnel_id=""
_file_api_key=""
_file_extra_headers=""
_profile_cache=""
ENVF="$HOME/.pro-review/env.sh"
if [ -f "$ENVF" ]; then
  owner=$(stat -f '%u' "$ENVF" 2>/dev/null || stat -c '%u' "$ENVF" 2>/dev/null)
  [ "$owner" = "$(id -u)" ] || { echo "[error] $ENVF の所有者が不正" >&2; exit 1; }
  perm=$(stat -f '%Lp' "$ENVF" 2>/dev/null || stat -c '%a' "$ENVF" 2>/dev/null)
  [ "$perm" = "600" ] || { echo "[warn] $ENVF を 0600 に修正" >&2; chmod 600 "$ENVF"; }
  _profile_cache=$(mktemp "${TMPDIR:-/tmp}/pro-review-tunnel-profile.XXXXXX")
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    key=$(_env_key_from_line "$line")
    val=$(_env_val_from_line "$line")
    case "$key" in
      PRO_REVIEW_TUNNEL_PROFILE)
        [ -z "${PRO_REVIEW_TUNNEL_PROFILE:-}" ] && _file_tunnel_profile="$val"
        ;;
      CONTROL_PLANE_TUNNEL_ID)
        _file_tunnel_id="$val"
        ;;
      CONTROL_PLANE_API_KEY)
        _file_api_key="$val"
        ;;
      CONTROL_PLANE_EXTRA_HEADERS)
        [ -z "${CONTROL_PLANE_EXTRA_HEADERS:-}" ] && _file_extra_headers="$val"
        ;;
      CONTROL_PLANE_TUNNEL_ID_*)
        suffix="${key#CONTROL_PLANE_TUNNEL_ID_}"
        if _profile_suffix_valid "$suffix"; then
          printf 'TUNNEL_ID\t%s\t%s\n' "$suffix" "$val" >> "$_profile_cache"
        fi
        ;;
      CONTROL_PLANE_API_KEY_*)
        suffix="${key#CONTROL_PLANE_API_KEY_}"
        if _profile_suffix_valid "$suffix"; then
          printf 'API_KEY\t%s\t%s\n' "$suffix" "$val" >> "$_profile_cache"
        fi
        ;;
      CONTROL_PLANE_ORG_ID_*)
        suffix="${key#CONTROL_PLANE_ORG_ID_}"
        if _profile_suffix_valid "$suffix"; then
          printf 'ORG_ID\t%s\t%s\n' "$suffix" "$val" >> "$_profile_cache"
        fi
        ;;
    esac
  done < "$ENVF"
fi

_auth_profile="${PRO_REVIEW_TUNNEL_PROFILE:-${_file_tunnel_profile:-}}"
_profile_tunnel_id=""
_profile_api_key=""
_profile_org_id=""
if [ -n "$_auth_profile" ] && [ -n "${_profile_cache:-}" ] && [ -s "$_profile_cache" ]; then
  while IFS=$'\t' read -r kind suffix val; do
    [ "$suffix" = "$_auth_profile" ] || continue
    case "$kind" in
      TUNNEL_ID) _profile_tunnel_id="$val" ;;
      API_KEY) _profile_api_key="$val" ;;
      ORG_ID) _profile_org_id="$val" ;;
    esac
  done < "$_profile_cache"
fi
[ -n "${_profile_cache:-}" ] && rm -f "$_profile_cache"

if [ -n "$_auth_profile" ] && { [ -n "$_profile_tunnel_id" ] || [ -n "$_profile_api_key" ]; }; then
  _resolved_auth_profile="$_auth_profile"
  [ -n "$_profile_tunnel_id" ] && export CONTROL_PLANE_TUNNEL_ID="$_profile_tunnel_id" && _resolved_tunnel_id="$_profile_tunnel_id"
  [ -n "$_profile_api_key" ] && export CONTROL_PLANE_API_KEY="$_profile_api_key"
  if [ -z "${CONTROL_PLANE_EXTRA_HEADERS:-}" ]; then
    if [ -n "$_profile_org_id" ]; then
      export CONTROL_PLANE_EXTRA_HEADERS="OpenAI-Organization: $_profile_org_id"
      _resolved_org_header="yes"
    elif [ -n "$_file_extra_headers" ]; then
      export CONTROL_PLANE_EXTRA_HEADERS="$_file_extra_headers"
      _extra_headers_has_org "$_file_extra_headers" && _resolved_org_header="yes"
    fi
  else
    _extra_headers_has_org "${CONTROL_PLANE_EXTRA_HEADERS}" && _resolved_org_header="yes"
  fi
else
  [ -n "$_file_tunnel_id" ] && export CONTROL_PLANE_TUNNEL_ID="$_file_tunnel_id" && _resolved_tunnel_id="$_file_tunnel_id"
  [ -n "$_file_api_key" ] && export CONTROL_PLANE_API_KEY="$_file_api_key"
  if [ -n "${CONTROL_PLANE_EXTRA_HEADERS:-}" ]; then
    _extra_headers_has_org "${CONTROL_PLANE_EXTRA_HEADERS}" && _resolved_org_header="yes"
  elif [ -n "$_file_extra_headers" ]; then
    export CONTROL_PLANE_EXTRA_HEADERS="$_file_extra_headers"
    _extra_headers_has_org "$_file_extra_headers" && _resolved_org_header="yes"
  fi
fi

_report_tunnel_auth

if [ "${PRO_REVIEW_TUNNEL_DRY_RUN:-}" = "1" ]; then
  exit 0
fi

if ! command -v tunnel-client >/dev/null 2>&1; then
  cat >&2 <<EOF
[setup] tunnel-client が見つからない。
  1) https://platform.openai.com/settings/organization/tunnels からバイナリをDL
  2) ~/.pro-review/bin/tunnel-client に置いて chmod +x
EOF
  exit 1
fi
: "${CONTROL_PLANE_TUNNEL_ID:?Platform Tunnels で発行した tunnel_id を環境変数にセット}"
: "${CONTROL_PLANE_API_KEY:?Platform Runtime API keys で発行した key を環境変数にセット}"

# プロファイルが無ければ作る（YAMLの有無で判定。既存なら作り直さない）
PROFILE_FILE="$HOME/.config/tunnel-client/$PROFILE.yaml"
if [ ! -f "$PROFILE_FILE" ]; then
  tunnel-client init --sample sample_mcp_stdio_local --profile "$PROFILE" \
    --tunnel-id "$CONTROL_PLANE_TUNNEL_ID" \
    --mcp-command "$MCP_CMD"
fi

if ! tunnel-client doctor --profile "$PROFILE" --explain; then
  [ "${FORCE_RUN:-}" = "1" ] || { echo "[error] doctor 失敗。原因を確認するか FORCE_RUN=1 で続行。" >&2; exit 1; }
fi
echo "[run] tunnel-client を起動。ChatGPT の Connectors で Tunnel モード + 同じ tunnel_id を登録して使う。"
exec tunnel-client run --profile "$PROFILE"
