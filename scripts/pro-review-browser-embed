#!/usr/bin/env bash
# Path A 用 orchestrator: ブラウザ埋め込み送信の依頼パケットを用意する。
#
# 役割（state-less。Path B の active-project は使わない）:
#   1) project 名を引数で受け取り検証
#   2) since（秒 epoch）を生成
#   3) build-review-packet を --for-browser で呼ぶ
#      - --github-branch BRANCH が来たら GitHub コネクタ指示モード（コード非埋込）
#      - 来なければ通常の embed モード（diff + 変更ファイル本文 + 末尾 DONE マーカー）
#   4) inbox/<project>/ を用意（後段の save-reply / watch / finish が使う）
#   5) 機械可読行 + 依頼文本体 を stdout に出力
#
# 使い方:
#   pro-review-browser-embed <repo> <project> [--question Q] [--github-branch BRANCH] [--no-clip]
#
# 出力（後段スクリプト/エージェントが parse する。説明を足さないこと）:
#   project_name: <project>
#   since: <epoch_seconds>
#   inbox: <abs path>
#   request_file: <abs path>
#   clip: yes|no
#   ---- ChatGPT(GPT-5.5 Pro) に貼る依頼 ----
#   <request body>
#   ----------------------------------------
set -euo pipefail

REPO="${1:?usage: pro-review-browser-embed <repo> <project> [--question Q] [--github-branch BRANCH] [--no-clip]}"
shift || true
PROJECT="${1:?project required}"
shift || true

QUESTION=""
GH_BRANCH=""
NO_CLIP=0
while [ "${1:-}" ]; do
  case "$1" in
    --question)       QUESTION="${2:-}"; shift 2;;
    --github-branch)  GH_BRANCH="${2:-}"; shift 2;;
    --no-clip)        NO_CLIP=1; shift;;
    *) shift;;
  esac
done

# project 名検証（snapshot/save-reply と同正規表現）
if ! printf '%s' "$PROJECT" | grep -qE '^[A-Za-z0-9._-]+$' || [ "$PROJECT" = "." ] || [ "$PROJECT" = ".." ]; then
  echo "[error] invalid project name: '$PROJECT' (allowed: alnum + . _ -)" >&2
  exit 2
fi

# repo 検証
if [ ! -d "$REPO" ]; then
  echo "[error] repo does not exist: $REPO" >&2
  exit 2
fi

SK="$HOME/.claude/skills/gpt-pro-review/scripts"
BASE="$HOME/.pro-review"
INBOX="$BASE/inbox/$PROJECT"
OUTBOX="$BASE/outbox"
mkdir -p "$INBOX" "$OUTBOX"

SINCE="$(date +%s)"
REQ="$OUTBOX/${PROJECT}-browser-${SINCE}.md"

CLIP_FLAG=""
[ "$NO_CLIP" = "1" ] && CLIP_FLAG="--no-clip"

# build-review-packet 呼び出し（secret scan は build-review-packet 側）
# GitHub ブランチ指定時はコード非埋込、未指定時は embed
EXTRA=()
[ -n "$GH_BRANCH" ] && EXTRA+=(--github-branch "$GH_BRANCH")

# stderr は親に流す（secret scan ヒット時の理由を見せたい）
# --github-branch 明示時のみ guard 解除（connector 経路はユーザー opt-in）
run_build() {
  if [ -n "$GH_BRANCH" ]; then
    env PRO_REVIEW_ALLOW_UNSCANNED_MODES=1 "$SK/build-review-packet" "$@"
  else
    "$SK/build-review-packet" "$@"
  fi
}

if ! run_build \
      --repo "$REPO" \
      --question "$QUESTION" \
      --for-browser \
      --since "$SINCE" \
      --out "$REQ" \
      $CLIP_FLAG \
      ${EXTRA[@]+"${EXTRA[@]}"} >/dev/null; then
  echo "[error] build-review-packet failed (secret scan or other)" >&2
  exit 1
fi

CLIP="no"
[ "$NO_CLIP" = "0" ] && command -v pbcopy >/dev/null 2>&1 && CLIP="yes"

# 機械可読
echo "project_name: $PROJECT"
echo "since: $SINCE"
echo "inbox: $INBOX"
echo "request_file: $REQ"
echo "clip: $CLIP"
echo "---- ChatGPT(GPT-5.5 Pro) に貼る依頼 ----"
cat "$REQ"
echo "----------------------------------------"
