#!/usr/bin/env bash
# Check Path B tunnel lifecycle state and print one next action.
set -euo pipefail

PROJECT="${1:-}"
[ -n "$PROJECT" ] || { echo "STOP_REASON=missing_project"; echo "NEXT_ACTION=run pro-review-start first"; exit 2; }
if ! printf '%s' "$PROJECT" | grep -qE '^[A-Za-z0-9._-]+$' || [ "$PROJECT" = "." ] || [ "$PROJECT" = ".." ]; then
  echo "STOP_REASON=invalid_project"
  echo "NEXT_ACTION=use a path-safe project name"
  exit 2
fi

SK="$(cd "$(dirname "$0")" && pwd -P)"
BASE="$HOME/.pro-review"
ACTIVE="$BASE/active-project"
HEALTH="${HEALTH_URL_FILE:-$BASE/health.url}"

ACTIVE_PROJECT=""
[ -f "$ACTIVE" ] && ACTIVE_PROJECT="$(tr -d '[:space:]' < "$ACTIVE")"
if [ -z "$ACTIVE_PROJECT" ]; then
  echo "STOP_REASON=no_active_project"
  echo "NEXT_ACTION=run pro-review-start <repo> $PROJECT"
  exit 2
fi
if [ "$ACTIVE_PROJECT" != "$PROJECT" ]; then
  echo "STOP_REASON=stale_active_project"
  echo "ACTIVE_PROJECT=$ACTIVE_PROJECT"
  echo "NEXT_ACTION=run pro-review-finish $ACTIVE_PROJECT or clear ~/.pro-review/active-project"
  exit 2
fi

if [ "${PRO_REVIEW_TUNNEL_DOCTOR_FAIL:-}" = "1" ]; then
  echo "STOP_REASON=doctor_failed"
  echo "NEXT_ACTION=run pro-review-doctor and fix FIX/MANUAL rows"
  exit 3
fi

if [ ! -s "$HEALTH" ]; then
  echo "STOP_REASON=tunnel_not_running"
  echo "NEXT_ACTION=run pro-review-tunnel in background"
  exit 3
fi
HEALTH_URL="$(cat "$HEALTH")"
if ! curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
  echo "STOP_REASON=tunnel_not_running"
  echo "HEALTH_URL=$HEALTH_URL"
  echo "NEXT_ACTION=run pro-review-tunnel in background"
  exit 3
fi

TOOLS=$(python3 <<EOF
import json, subprocess, sys
p = subprocess.Popen(["$SK/pro-review-mcp-search-fetch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
def send(m):
    p.stdin.write(json.dumps(m) + "\n")
    p.stdin.flush()
def recv():
    return json.loads(p.stdout.readline())
send({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"check","version":"0"}}})
recv()
send({"jsonrpc":"2.0","method":"notifications/initialized"})
send({"jsonrpc":"2.0","id":2,"method":"tools/list"})
resp = recv()
p.stdin.close()
p.terminate()
print(",".join(t["name"] for t in resp["result"]["tools"]))
EOF
)
if [ "${PRO_REVIEW_READONLY:-}" = "1" ]; then
  case ",$TOOLS," in
    *,save_report,*)
      echo "STOP_REASON=readonly_expected"
      echo "TOOLS=$TOOLS"
      echo "NEXT_ACTION=restart pro-review-tunnel with PRO_REVIEW_READONLY=1"
      exit 3
      ;;
  esac
else
  case ",$TOOLS," in
    *,save_report,*) ;;
    *)
      echo "STOP_REASON=save_report_unavailable"
      echo "TOOLS=$TOOLS"
      echo "NEXT_ACTION=use current pro-review-mcp-search-fetch or fallback to DOM save-reply"
      exit 3
      ;;
  esac
fi

echo "OK tunnel_lifecycle"
echo "ACTIVE_PROJECT=$PROJECT"
echo "HEALTH_URL=$HEALTH_URL"
if [ "${PRO_REVIEW_READONLY:-}" = "1" ]; then echo "MODE=readonly"; fi
echo "TOOLS=$TOOLS"
