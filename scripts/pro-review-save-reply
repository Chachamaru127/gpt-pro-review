#!/usr/bin/env python3
"""ブラウザ DOM 抽出 or 手貼り経由で得た ChatGPT 返信を inbox にアトミックに保存する。

使い方:
  echo "<reply text>" | pro-review-save-reply <project> <run_id>
  pro-review-save-reply <project> <run_id> --text "<reply text>"

  run_id は path-safe [A-Za-z0-9._-]+（例: 1700000000123-a1b2c3）。
  後方互換: 非負整数のみの旧 since 値も引き続き受理する。

出力:
  saved: <inbox/<project>/REPLY-<run_id>.md の絶対パス>

設計（合議で確定）:
- アトミック書き込み: tmp ファイルに書いて os.rename で確定（同一 FS なら原子的）
- project 名検証: `^[A-Za-z0-9._-]+$`（snapshot/finish と同正規表現）
- run_id 検証: path-safe `[A-Za-z0-9._-]+`、`.`/`..` 拒否（数値のみも可）
- 出力先強制: realpath で inbox/<project> 配下に正規化されることを確認
- symlink 拒否: 既存の出力先が symlink なら拒否（誤書込み防止）
- stdin と --text は排他
- サイズ上限なし・UTF-8 強制なし（バイナリ透過保存。ChatGPT 出力にコードフェンス内の生バイトが混ざりうるため）
"""
import argparse, os, re, stat, sys, tempfile

PROJECT_RE = re.compile(r"^[A-Za-z0-9._-]+$")
RUN_ID_RE  = re.compile(r"^[A-Za-z0-9._-]+$")

def die(msg, code=2):
    sys.stderr.write(f"[pro-review-save-reply] error: {msg}\n")
    sys.exit(code)

def main():
    ap = argparse.ArgumentParser(description="Save a ChatGPT reply atomically to the project's inbox.")
    ap.add_argument("project", help="project name (alnum + . _ -)")
    ap.add_argument("run_id", help="path-safe run id (e.g. epoch_ms-hex) or legacy numeric since")
    ap.add_argument("--text", help="reply content (mutually exclusive with stdin)")
    args = ap.parse_args()

    project = args.project
    run_id  = args.run_id

    if not PROJECT_RE.match(project) or project in (".", ".."):
        die(f"invalid project name: {project!r} (must match {PROJECT_RE.pattern})")
    if not RUN_ID_RE.match(run_id) or run_id in (".", ".."):
        die(f"invalid run_id: {run_id!r} (must be path-safe {RUN_ID_RE.pattern}, not . or ..)")
    if run_id.startswith(("-", ".")):
        die(f"invalid run_id: {run_id!r} (must not start with '-' or '.')")

    # 入力ソース: stdin と --text を排他
    # stdin が pipe か通常ファイルにリダイレクトされている時だけ「データあり」と判定。
    # 親 tty 継承や /dev/null 継承では誤検知しない（S_ISFIFO/S_ISREG で厳密判定）。
    try:
        st_mode = os.fstat(0).st_mode
        stdin_has_data = stat.S_ISFIFO(st_mode) or stat.S_ISREG(st_mode)
    except OSError:
        stdin_has_data = False
    if args.text is not None and stdin_has_data:
        die("stdin and --text are mutually exclusive")

    if args.text is not None:
        payload = args.text.encode("utf-8", errors="replace")
    elif stdin_has_data:
        payload = sys.stdin.buffer.read()
    else:
        die("no input: pipe stdin or pass --text")

    if not payload:
        die("input is empty")

    base = os.path.expanduser("~/.pro-review")
    inbox = os.path.join(base, "inbox", project)
    os.makedirs(inbox, exist_ok=True)

    # 出力先強制: realpath で inbox 配下を出ない
    inbox_real = os.path.realpath(inbox)
    dest = os.path.join(inbox_real, f"REPLY-{run_id}.md")
    dest_real_dir = os.path.realpath(os.path.dirname(dest))
    if not (dest_real_dir == inbox_real or dest_real_dir.startswith(inbox_real + os.sep)):
        die(f"destination escapes inbox: {dest}")

    # 既存の出力先 symlink は拒否
    if os.path.islink(dest):
        die(f"refuse to overwrite symlink: {dest}")

    # アトミック書き込み: tmp ファイル on same dir → os.rename
    tmp_fd, tmp_path = tempfile.mkstemp(prefix=".tmp.REPLY-", suffix=".md", dir=inbox_real)
    try:
        with os.fdopen(tmp_fd, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        # rename はファイルレベルでアトミック（同一 FS）
        os.rename(tmp_path, dest)
    except Exception as e:
        # クリーンアップしてから落とす
        try: os.unlink(tmp_path)
        except OSError: pass
        die(f"write failed: {e}", code=1)

    print(f"saved: {dest}")

if __name__ == "__main__":
    main()
