CONNECTOR_SEARCH_RESULT_TIMEOUT_S = 10.0

DOM_EXCERPT_MAX_BYTES = 512 * 1024

_ARTIFACT_RUNTIME = {
    "artifact_dir": None,
    "fixture_html_path": None,
    "fixture_html_cache": None,
    "page": None,
}

DEEP_RESEARCH_NEED_PATTERNS = [
    ("explicit-deep-research", re.compile(r"\bdeep\s*research\b|deepresearch|ディープリサーチ", re.I)),
    ("multi-source", re.compile(r"複数ソース|横断|multi[- ]?source", re.I)),
    ("research", re.compile(r"調査|リサーチ|\bresearch\b", re.I)),
    ("current-external", re.compile(r"最新|現在|外部|公式\s*(doc|docs|document|ドキュメント)|仕様|release notes?", re.I)),
    ("security-advisory", re.compile(r"\bCVE\b|脆弱性|advisory|security bulletin", re.I)),
    ("market-compare", re.compile(r"競合|比較|benchmark|market|ベストプラクティス|best practices?", re.I)),
    ("legal-regulatory", re.compile(r"法務|規制|regulat|compliance", re.I)),
]


class AssistantParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = 0
        self.capture_depth = 0
        self.current = []
        self.messages = []
        self.stop_visible = False
        self.login_required = False

    def handle_starttag(self, tag, attrs):
        self.depth += 1
        attrs_d = dict(attrs)
        label_blob = " ".join(
            str(attrs_d.get(k, ""))
            for k in ("aria-label", "data-testid", "href", "role")
        ).lower()
        if attrs_d.get("data-message-author-role") == "assistant":
            self.capture_depth = self.depth
            self.current = []
        if "stop" in label_blob and tag.lower() == "button":
            self.stop_visible = True
        if tag.lower() in {"button", "a"} and (
            "login-button" in label_blob
            or re.search(r"\b(log\s*in|sign\s*in)\b", label_blob, re.I)
        ):
            self.login_required = True

    def handle_endtag(self, tag):
        if self.capture_depth and self.depth == self.capture_depth:
            text = "\n".join(part.strip() for part in self.current if part.strip())
            if text.strip():
                self.messages.append(text.strip())
            self.capture_depth = 0
            self.current = []
        self.depth = max(0, self.depth - 1)

    def handle_data(self, data):
        if self.capture_depth:
            self.current.append(data)


def summarize_browser_state(state):
    """Operator-facing one-liner derived from a BROWSER_STATE snapshot."""
    if not state:
        return "unknown"
    parts = []
    if state.get("generating"):
        parts.append("generating")
    elif state.get("copyButtonVisible"):
        parts.append("copy-ready")
    else:
        parts.append("idle-or-unknown")
    status = state.get("status") or ""
    if status:
        parts.append(str(status))
    parts.append(f"assistant={state.get('assistantTurns', 0)}")
    return "; ".join(parts)


def state_from_parser(parser):
    """Build a coarse BROWSER_STATE dict from static HTML fixture parsing."""
    return {
        "generating": bool(parser.stop_visible),
        "status": "stop visible" if parser.stop_visible else "",
        "userTurns": 0,
        "assistantTurns": len(parser.messages),
        "loginRequired": bool(parser.login_required),
        "composerVisible": False,
        "copyButtonVisible": False,
    }


def configure_artifact_runtime(args):
    _ARTIFACT_RUNTIME["artifact_dir"] = args.artifact_dir or None
    _ARTIFACT_RUNTIME["fixture_html_path"] = args.fixture_html
    _ARTIFACT_RUNTIME["fixture_html_cache"] = None
    _ARTIFACT_RUNTIME["page"] = None


def _clip_dom_excerpt(html):
    if not html:
        return ""
    raw = html.encode("utf-8", errors="replace")
    if len(raw) <= DOM_EXCERPT_MAX_BYTES:
        return html
    return raw[:DOM_EXCERPT_MAX_BYTES].decode("utf-8", errors="replace")


def _read_fixture_html():
    cached = _ARTIFACT_RUNTIME.get("fixture_html_cache")
    if cached is not None:
        return cached
    path = _ARTIFACT_RUNTIME.get("fixture_html_path")
    if not path or not os.path.isfile(path):
        return None
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", errors="replace")
    except OSError:
        return None


def _prepare_artifact_dir(artifact_dir):
    os.makedirs(artifact_dir, exist_ok=True)
    os.chmod(artifact_dir, 0o700)


def _write_dom_excerpt(artifact_dir, html):
    if not html:
        return
    path = os.path.join(artifact_dir, "dom-excerpt.html")
    with open(path, "w", encoding="utf-8") as f:
        f.write(_clip_dom_excerpt(html))
    os.chmod(path, 0o600)


async def _save_screenshot_best_effort(page, artifact_dir):
    path = os.path.join(artifact_dir, "screenshot.png")
    try:
        if hasattr(page, "save_screenshot"):
            await page.save_screenshot(path)
        elif hasattr(page, "screenshot"):
            data = await page.screenshot()
            if data:
                with open(path, "wb") as f:
                    f.write(data)
            else:
                return
        else:
            return
        os.chmod(path, 0o600)
    except Exception as exc:
        sys.stderr.write(
            f"[pro-review-browser-drive] warning: screenshot save failed: {exc}\n"
        )


def _emit_artifacts_line(artifact_dir):
    print(f"ARTIFACTS:{artifact_dir}")


def save_diagnostic_artifacts_sync():
    artifact_dir = _ARTIFACT_RUNTIME.get("artifact_dir")
    if not artifact_dir:
        return
    _prepare_artifact_dir(artifact_dir)
    html = _read_fixture_html()
    _write_dom_excerpt(artifact_dir, html)
    _emit_artifacts_line(artifact_dir)


async def save_diagnostic_artifacts_async():
    artifact_dir = _ARTIFACT_RUNTIME.get("artifact_dir")
    if not artifact_dir:
        return
    _prepare_artifact_dir(artifact_dir)
    html = None
    page = _ARTIFACT_RUNTIME.get("page")
    if page is not None:
        try:
            html = await page.get_content()
        except Exception:
            html = None
    if html is None:
        html = _read_fixture_html()
    _write_dom_excerpt(artifact_dir, html)
    if page is not None:
        await _save_screenshot_best_effort(page, artifact_dir)
    _emit_artifacts_line(artifact_dir)


def _emit_fallback(reason, state=None):
    if state:
        print(
            "BROWSER_STATE:"
            + json.dumps(state, ensure_ascii=False, separators=(",", ":"))
        )
        print(f"BROWSER_STATE_SUMMARY:{summarize_browser_state(state)}")
    print(f"FALLBACK:{reason}")
    return 3


def fallback(reason, state=None):
    save_diagnostic_artifacts_sync()
    return _emit_fallback(reason, state)


async def afallback(reason, state=None):
    await save_diagnostic_artifacts_async()
    return _emit_fallback(reason, state)


RUN_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def validate_run_id(run_id):
    """path-safe [A-Za-z0-9._-]+、"."/".." 拒否、先頭 "-"/"." 拒否。"""
    if not run_id or not RUN_ID_RE.match(run_id) or run_id in (".", ".."):
        return False
    if run_id.startswith(("-", ".")):
        return False
    return True


def validate_conversation_url(url):
    """Return url when host is exactly chatgpt.com over https; else None."""
    if not url or not isinstance(url, str):
        return None
    candidate = url.strip()
    if not candidate:
        return None
    try:
        parsed = urlparse(candidate)
    except ValueError:
        return None
    if parsed.scheme != "https":
        return None
    host = (parsed.hostname or "").lower()
    if host != CHATGPT_CONVERSATION_HOST:
        return None
    return candidate


def is_conversation_url(url):
    """Return True when url is a validated chatgpt.com /c/ conversation link."""
    validated = validate_conversation_url(url)
    if validated is None:
        return False
    try:
        parsed = urlparse(validated)
    except ValueError:
        return False
    return (parsed.path or "").startswith("/c/")


def conversation_url_outbox_path(run_id):
    """Build the outbox path for run_id's staged conversation URL.

    run_id は path-safe な形式でなければならない。加えて、生成したパスの
    realpath が outbox 直下であること・既存 symlink でないことを強制する
    (呼び出し元が CLI --run-id 検証を経由しない場合の第二防御線)。
    """
    if not validate_run_id(run_id):
        return None
    outbox = os.path.expanduser("~/.pro-review/outbox")
    path = os.path.join(outbox, f"conversation-url-{run_id}")
    if os.path.islink(path):
        return None
    outbox_real = os.path.realpath(outbox)
    if os.path.dirname(os.path.realpath(path)) != outbox_real:
        return None
    return path


def persist_conversation_url(run_id, url):
    """Validate and stage conversation URL for finish. Returns validated url or None."""
    validated = validate_conversation_url(url)
    if validated is None:
        if url and str(url).strip():
            sys.stderr.write(
                "[pro-review-browser-drive] conversation url rejected"
                f" (host must be {CHATGPT_CONVERSATION_HOST}): {url}\n"
            )
        return None
    path = conversation_url_outbox_path(run_id)
    if path is None:
        sys.stderr.write(
            "[pro-review-browser-drive] conversation url outbox path rejected"
            f" for run_id: {run_id!r}\n"
        )
        return None
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(validated)
        f.write("\n")
    os.chmod(path, 0o600)
    try:
        os.chmod(os.path.dirname(path), 0o700)
    except OSError:
        pass
    return validated


def load_persisted_conversation_url(run_id):
    """Load staged conversation URL and re-validate host before use."""
    path = conversation_url_outbox_path(run_id)
    if not path or not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as f:
            raw = f.read().strip()
    except OSError:
        return None
    return validate_conversation_url(raw)


def resolve_reopen_conversation_url(run_id):
    """Return validated staging URL for extract-only re-open, or None."""
    path = conversation_url_outbox_path(run_id)
    if not path or not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as f:
            raw = f.read().strip()
    except OSError:
        return None
    if not raw:
        return None
    validated = validate_conversation_url(raw)
    if validated is None:
        sys.stderr.write(
            "[pro-review-browser-drive] conversation url rejected for reopen"
            f" (host must be {CHATGPT_CONVERSATION_HOST}): {raw}\n"
        )
        return None
    return validated


def connector_unavailable(label, detail=""):
    print("STOP_REASON=connector_unavailable")
    print(f"NEXT_ACTION=ChatGPT側で{label}をこのチャットで有効化")
    if detail:
        print(f"DETAIL={detail}")
    return 3


def validate_reply(text, run_id):
    """正本は pro-review-validate-reply(最終行が marker と完全一致)。

    DOM 抽出は末尾に空行やコードフェンス(```)・バッククォート囲みが付きやすい。
    マーカーが「最後の内容行」であれば完了とみなすが、返り値はそのまま返さず
    最終行が素の marker になるよう正規化する。正規化できない(前後に他の
    文字が混ざる等)場合は不合格にする。
    """
    marker = f"[[DONE-{run_id}]]"
    if not text.strip():
        raise ValueError("assistant reply is empty")
    if text.count(marker) != 1:
        raise ValueError("DONE marker must appear exactly once on the final line")
    lines = [ln.rstrip() for ln in text.splitlines()]
    while lines and (lines[-1] == "" or lines[-1].lstrip("`").strip() == ""):
        lines.pop()
    if not lines:
        raise ValueError("assistant reply is empty")
    last = lines[-1].strip().strip("`").strip()
    if last != marker:
        raise ValueError(f"final line must be {marker}")
    lines[-1] = marker
    return "\n".join(lines)


def markdown_section(text, heading):
    pattern = re.compile(
        rf"(?ms)^##\s+{re.escape(heading)}\s*$\n?(.*?)(?=^##\s+|\Z)"
    )
    match = pattern.search(text)
    return match.group(1).strip() if match else ""


def parse_deep_research_policy(request_text):
    match = re.search(
        r"(?mi)^\s*-\s*deep_research:\s*`?(auto|on|off)`?\s*$",
        request_text,
    )
    return match.group(1).lower() if match else "auto"


def infer_deep_research_needed(request_text):
    review_question = markdown_section(request_text, "レビュー観点")
    if not review_question:
        return False, "no review question"
    hits = []
    for name, pattern in DEEP_RESEARCH_NEED_PATTERNS:
        if pattern.search(review_question):
            hits.append(name)
    if hits:
        return True, ",".join(hits[:3])
    return False, "no research signal"


def decide_deep_research_selection(policy, request_text):
    if policy == "on":
        return True, "explicit on"
    if policy == "off":
        return False, "explicit off"
    needed, reason = infer_deep_research_needed(request_text)
    if needed:
        return True, f"auto:{reason}"
    return False, f"auto:{reason}"


def extract_from_html(path, run_id):
    with open(path, "rb") as f:
        raw = f.read().decode("utf-8", errors="replace")
    _ARTIFACT_RUNTIME["fixture_html_cache"] = raw
    parser = AssistantParser()
    parser.feed(raw)
    state = state_from_parser(parser)
    if parser.login_required:
        return fallback("login required", state)
    if parser.stop_visible:
        return fallback("response still generating", state)
    if not parser.messages:
        return fallback("assistant reply not found", state)
    reply = html.unescape(parser.messages[-1])
    try:
        print(validate_reply(reply, run_id))
        return 0
    except ValueError as e:
        sys.stderr.write(f"[pro-review-browser-drive] error: {e}\n")
        return 2


def fixture_connector_send(path, label):
    with open(path, "rb") as f:
        raw = f.read().decode("utf-8", errors="replace")
    _ARTIFACT_RUNTIME["fixture_html_cache"] = raw
    parser = AssistantParser()
    parser.feed(raw)
    if parser.login_required:
        return fallback("login required")
    normalized = re.sub(r"\s+", " ", raw).lower()
    if label.lower() not in normalized:
        save_diagnostic_artifacts_sync()
        return connector_unavailable(label, "connector label not found in fixture")
    if not re.search(r'id=["\']prompt-textarea["\']|textarea|contenteditable=["\']true["\']|composer-text-input|ProseMirror', raw, re.I):
        return fallback("composer not found")
    print("sent: connector")
    print(f"connector_label: {label}")
    return 0


def live_paths():
    base = os.path.expanduser("~/.pro-review/browser")
    return {
        "base": base,
        "profile": os.path.join(base, "profile"),
        "login_marker": os.path.join(base, "profile", ".chatgpt-login-ok"),
        "venv_python": os.path.join(base, "venv", "bin", "python"),
    }


def find_chrome():
    candidates = [
        os.environ.get("PRO_REVIEW_CHROME"),
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary",
    ]
    for path in candidates:
        if path and os.path.exists(path):
            return path
    return None


def ensure_live_python():
    try:
        import nodriver  # noqa: F401
        return True
    except Exception:
        paths = live_paths()
        venv_python = paths["venv_python"]
        current = os.path.abspath(sys.executable)
        target = os.path.abspath(venv_python)
        if (
            os.path.exists(venv_python)
            and current != target
            and os.environ.get("PRO_REVIEW_BROWSER_REEXEC") != "1"
        ):
            os.environ["PRO_REVIEW_BROWSER_REEXEC"] = "1"
            os.execv(venv_python, [venv_python] + sys.argv)
        return False


async def js(page, expression):
    return await page.evaluate(expression, await_promise=True, return_by_value=True)


async def current_page_url(page):
    href = await js(page, "window.location.href")
    return str(href).strip() if href else ""


async def wait_conversation_url(page, timeout_s):
    """Poll page URL until a /c/ conversation link appears or timeout."""
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        page_url = await current_page_url(page)
        if is_conversation_url(page_url):
            return page_url
        await page.sleep(1.0)
    return None


def js_object(result):
    if isinstance(result, Mapping):
        return dict(result)
    if isinstance(result, str):
        try:
            parsed = json.loads(result)
        except json.JSONDecodeError:
            return None
        return dict(parsed) if isinstance(parsed, Mapping) else None
    value = getattr(result, "value", None)
    if isinstance(value, Mapping):
        return dict(value)
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            return None
        return dict(parsed) if isinstance(parsed, Mapping) else None
    deep_value = getattr(getattr(result, "deep_serialized_value", None), "value", None)
    if isinstance(deep_value, list):
        obj = {}
        for item in deep_value:
            if not isinstance(item, list) or len(item) != 2:
                continue
            key, desc = item
            if isinstance(desc, Mapping) and "value" in desc:
                obj[str(key)] = desc.get("value")
        if obj:
            return obj
    return None


async def clear_prompt(page):
    script = f"""
(() => {{
  const selectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const el = selectors.map(s => document.querySelector(s)).find(Boolean);
  if (!el) return false;
  el.focus();
  if (el.tagName === 'TEXTAREA' || el.tagName === 'INPUT') {{
    el.value = '';
  }} else {{
    el.textContent = '';
  }}
  el.dispatchEvent(new InputEvent('input', {{
    bubbles: true,
    cancelable: true,
    inputType: 'deleteContentBackward',
    data: null
  }}));
  el.dispatchEvent(new Event('change', {{ bubbles: true }}));
  return true;
}})()
"""
    return await js(page, script)


async def click_deep_research_candidate(page):
    script = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const disabled = (el) =>
    el.disabled || el.getAttribute('aria-disabled') === 'true' ||
    el.getAttribute('data-disabled') === 'true';
  const composer = (el) =>
    el.matches({json.dumps(COMPOSER_MATCH_SELECTOR)}) ||
    Boolean(el.closest({json.dumps(COMPOSER_MATCH_SELECTOR)}));
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.getAttribute('role'),
    el.textContent
  ].filter(Boolean).join(' '));
  const deep = /(deep\\s*resear?ch|deepresearch|deepreseach|ディープ\\s*リサーチ|詳細.*リサーチ|深い.*調査|高度な.*調査)/i;
  const elements = [
    ...document.querySelectorAll({json.dumps(MENU_SCAN_DEEP_RESEARCH)})
  ];
  const matches = elements
    .map((el) => ({{
      el,
      label: labelOf(el),
      target: el.closest({json.dumps(MENU_TARGET_DEEP_RESEARCH)}) || el
    }}))
    .filter((item) => item.label && deep.test(item.label) && visible(item.el) && visible(item.target) && !disabled(item.target))
    .filter((item) => !composer(item.el) && !composer(item.target))
    .sort((a, b) => a.label.length - b.label.length);
  for (const item of matches) {{
    try {{
      item.target.click();
      return {{ ok: true, label: item.label.slice(0, 160) }};
    }} catch (_) {{
      continue;
    }}
  }}
  return {{ ok: false, reason: 'deep research item not found' }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid click result ({type(result).__name__})",
    }


async def click_tools_menu_candidate(page):
    script = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const disabled = (el) =>
    el.disabled || el.getAttribute('aria-disabled') === 'true' ||
    el.getAttribute('data-disabled') === 'true';
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.textContent
  ].filter(Boolean).join(' '));
  const score = (el) => {{
    const label = labelOf(el).toLowerCase();
    if (!label || !visible(el) || disabled(el)) return 0;
    if (el.id === 'composer-plus-btn' || el.getAttribute('data-testid') === 'composer-plus-btn') return 8;
    if (/ファイルなどを追加/.test(label)) return 7;
    if (/\\btools?\\b|ツール/.test(label)) return 5;
    if (/composer.*plus|plus.*composer|add.*tools?/.test(label)) return 4;
    if (/添付|attach|add|追加|\\+/.test(label)) return 2;
    return 0;
  }};
  const buttons = [...document.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})]
    .map((el) => ({{ el, score: score(el), label: labelOf(el) }}))
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score);
  if (!buttons.length) return {{ ok: false, reason: 'tools menu not found' }};
  buttons[0].el.click();
  return {{ ok: true, label: buttons[0].label.slice(0, 160) }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid tools result ({type(result).__name__})",
    }


def connector_search_prefix(label):
    cleaned = re.sub(r"\s+", " ", str(label or "")).strip()
    if not cleaned:
        return ""
    return cleaned[:CONNECTOR_SEARCH_PREFIX_LEN]


def connector_mention_query(label):
    cleaned = re.sub(r"\s+", " ", str(label or "")).strip()
    return re.sub(r"\s+tunnel\s+connector$", "", cleaned, flags=re.I)


def connector_pill_verify_js(label):
    payload = json.dumps(label)
    return f"""
(() => {{
  const wanted = String({payload} || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  if (!wanted) return {{ ok: false, reason: 'empty connector label' }};
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const selectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const el = selectors.map(s => document.querySelector(s)).find(Boolean);
  if (!el) return {{ ok: false, reason: 'composer not found', hasPill: false, hasLabel: false }};
  const root = el.closest('.ProseMirror') || el;
  const hasPill = Boolean(root.querySelector('[data-inline-selection-pill-cursor-target]'));
  const text = norm(root.innerText || root.textContent || '');
  const hasLabel = text.toLowerCase().includes(wanted);
  return {{
    ok: hasPill && hasLabel,
    hasPill,
    hasLabel,
    length: text.length
  }};
}})()
"""


def connector_search_click_js(label):
    payload = json.dumps(label)
    return f"""
(() => {{
  const wanted = String({payload} || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  if (!wanted) return {{ ok: false, reason: 'empty connector label' }};
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const disabled = (el) =>
    el.disabled || el.getAttribute('aria-disabled') === 'true' ||
    el.getAttribute('data-disabled') === 'true';
  const composer = (el) =>
    el.matches({json.dumps(COMPOSER_MATCH_SELECTOR)}) ||
    Boolean(el.closest({json.dumps(COMPOSER_MATCH_SELECTOR)}));
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.getAttribute('role'),
    el.textContent
  ].filter(Boolean).join(' '));
  function dispatchClickSequence(target) {{
    if (!target || !(target instanceof EventTarget)) return false;
    const types = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
    for (const type of types) {{
      const common = {{ bubbles: true, cancelable: true, view: window }};
      let event;
      if (type.startsWith('pointer') && 'PointerEvent' in window) {{
        event = new PointerEvent(type, {{ ...common, pointerId: 1, pointerType: 'mouse' }});
      }} else {{
        event = new MouseEvent(type, common);
      }}
      target.dispatchEvent(event);
    }}
    return true;
  }}
  const score = (label) => {{
    const lower = label.toLowerCase();
    if (lower === wanted) return 100;
    if (lower.includes(wanted)) return 90;
    if (wanted.includes(lower) && lower.length >= 8) return 60;
    return 0;
  }};
  const elements = [
    ...document.querySelectorAll({json.dumps(MENU_SCAN_CONNECTOR_CANDIDATE)})
  ];
  const matches = elements
    .map((el, index) => ({{
      el,
      index,
      label: labelOf(el),
      target: el.closest({json.dumps(MENU_TARGET_CONNECTOR)}) || el
    }}))
    .map((item) => ({{ ...item, score: score(item.label) }}))
    .filter((item) => item.score > 0 && visible(item.el) && visible(item.target) && !disabled(item.target))
    .filter((item) => !composer(item.el) && !composer(item.target))
    .sort((a, b) => b.score - a.score || a.index - b.index);
  for (const item of matches) {{
    try {{
      dispatchClickSequence(item.target);
      return {{ ok: true, label: item.label.slice(0, 160) }};
    }} catch (_) {{
      continue;
    }}
  }}
  return {{ ok: false, reason: 'connector search result not found' }};
}})()
"""


async def verify_connector_pill(page, label):
    result = await js(page, connector_pill_verify_js(label))
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid pill verify result ({type(result).__name__})",
    }


async def click_connector_search_result(page, label):
    result = await js(page, connector_search_click_js(label))
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid search click result ({type(result).__name__})",
    }


async def focus_connector_menu_search(page):
    script = f"""
(() => {{
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const composer = (el) =>
    el.id === 'prompt-textarea' ||
    el.getAttribute('name') === 'prompt-textarea' ||
    Boolean(el.closest('form[data-type="unified-composer"]'));
  const labelOf = (el) => String([
    el.getAttribute('aria-label'),
    el.getAttribute('placeholder'),
    el.getAttribute('data-testid'),
    el.getAttribute('role'),
    el.textContent
  ].filter(Boolean).join(' ')).replace(/\\s+/g, ' ').trim();
  const inputs = [...document.querySelectorAll(
    'input:not([type="file"]),textarea,[role="searchbox"],[role="textbox"],[contenteditable="true"]'
  )].filter((el) => visible(el) && !composer(el));
  if (inputs.length) {{
    inputs[0].focus();
    return {{ ok: true, target: labelOf(inputs[0]).slice(0, 160) || inputs[0].tagName }};
  }}
  const menuTarget = [
    ...document.querySelectorAll(
      '.popover [data-highlighted][tabindex="0"],.popover [tabindex="0"]'
    )
  ].find(visible);
  if (menuTarget) {{
    menuTarget.focus();
    return {{
      ok: true,
      target: `keyboard-filter:${{labelOf(menuTarget).slice(0, 120)}}`
    }};
  }}
  const controls = [...document.querySelectorAll(
    '[role="menuitem"],[role="option"],[cmdk-item],button,[role="button"]'
  )].filter(visible).filter((el) => !composer(el)).map(labelOf).filter(Boolean);
  return {{
    ok: false,
    reason: 'connector menu search input not found',
    controls: [...new Set(controls)].slice(-20).join(' || ')
  }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid menu search focus result ({type(result).__name__})",
    }


async def send_keys_to_active_page(page, text):
    """Dispatch real key events without moving focus away from an open menu."""
    from nodriver import cdp

    for char in text:
        await page.send(cdp.input_.dispatch_key_event("keyDown", key=char))
        await page.send(cdp.input_.dispatch_key_event("char", text=char))
        await page.send(cdp.input_.dispatch_key_event("keyUp", key=char))


async def select_connector_via_mention(page, label, editor, timeout):
    query = connector_mention_query(label)
    if not query:
        return False, "mention=empty connector label"
    await clear_prompt(page)
    try:
        await editor.click()
        await editor.send_keys(f"@{query}")
    except Exception as exc:
        return False, f"mention-keys={exc}"
    deadline = time.time() + min(timeout, CONNECTOR_SEARCH_RESULT_TIMEOUT_S)
    last_reason = "connector mention result not found"
    while time.time() < deadline:
        clicked = await click_connector_search_result(page, label)
        if clicked.get("ok"):
            await page.sleep(0.5)
            selected_label = clicked.get("label") or query
            verified = await verify_connector_pill(page, selected_label)
            if verified.get("ok"):
                return True, f"mention:@{query}->{selected_label}"
            return False, (
                "mention-pill-missing:"
                f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}"
            )
        last_reason = clicked.get("reason", last_reason)
        await page.sleep(CONNECTOR_SEARCH_POLL_INTERVAL_S)
    await clear_prompt(page)
    return False, f"mention={last_reason}"


async def select_connector_via_menu_search(page, label, timeout):
    prefix = connector_search_prefix(label)
    if not prefix:
        return False, "search=empty connector label"
    opened = await click_connector_menu_candidate(page)
    if not opened.get("ok"):
        return False, f"search-menu={opened.get('reason', 'not found')}"
    await page.sleep(0.5)
    clicked = await click_connector_search_result(page, label)
    if clicked.get("ok"):
        await page.sleep(0.5)
        selected_label = clicked.get("label") or label
        verified = await verify_connector_pill(page, selected_label)
        if verified.get("ok"):
            return True, f"menu:{selected_label}"
        return False, (
            "menu-pill-missing:"
            f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}"
        )
    focused = await focus_connector_menu_search(page)
    if not focused.get("ok"):
        controls = str(focused.get("controls") or "")
        return False, (
            f"focus={focused.get('reason', 'connector menu search input not found')};"
            f"controls={controls[:1000]}"
        )
    try:
        await send_keys_to_active_page(page, prefix)
    except Exception as exc:
        return False, f"search-keys={exc}"
    deadline = time.time() + min(timeout, CONNECTOR_SEARCH_RESULT_TIMEOUT_S)
    last_reason = "connector search result not found"
    while time.time() < deadline:
        clicked = await click_connector_search_result(page, label)
        if clicked.get("ok"):
            await page.sleep(0.5)
            selected_label = clicked.get("label") or label
            verified = await verify_connector_pill(page, selected_label)
            if verified.get("ok"):
                return True, f"search:{prefix}->{selected_label}"
            return False, (
                "search-pill-missing:"
                f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}"
            )
        last_reason = clicked.get("reason", last_reason)
        await page.sleep(CONNECTOR_SEARCH_POLL_INTERVAL_S)
    controls = str(focused.get("controls") or "")
    focus_detail = (
        f"focus={focused.get('target')}"
        if focused.get("ok")
        else f"focus={focused.get('reason')};controls={controls[:1000]}"
    )
    return False, f"search={last_reason};{focus_detail}"


async def is_connector_selected(page, label):
    payload = json.dumps(label)
    script = f"""
(() => {{
  const wanted = String({payload} || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  if (!wanted) return {{ ok: false, reason: 'empty connector label' }};
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.textContent
  ].filter(Boolean).join(' '));
  const selected = (el) => {{
    const target = el.closest({json.dumps(SELECTED_STATE_CLOSEST)}) || el;
    const ariaChecked = target.getAttribute('aria-checked');
    const ariaSelected = target.getAttribute('aria-selected');
    const ariaPressed = target.getAttribute('aria-pressed');
    const dataState = (target.getAttribute('data-state') || '').toLowerCase();
    return ariaChecked === 'true' || ariaSelected === 'true' || ariaPressed === 'true' ||
      ['checked', 'selected', 'on', 'active'].includes(dataState);
  }};
  const elements = [...document.querySelectorAll({json.dumps(MENU_SCAN_CONNECTOR_SELECTED)})];
  for (const el of elements) {{
    const label = labelOf(el).toLowerCase();
    if (label && label.includes(wanted) && visible(el) && selected(el)) {{
      return {{ ok: true, label: labelOf(el).slice(0, 160) }};
    }}
  }}
  return {{ ok: false, reason: 'selected connector not found' }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid selected result ({type(result).__name__})",
    }


async def click_connector_candidate(page, label):
    payload = json.dumps(label)
    script = f"""
(() => {{
  const wanted = String({payload} || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  if (!wanted) return {{ ok: false, reason: 'empty connector label' }};
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const disabled = (el) =>
    el.disabled || el.getAttribute('aria-disabled') === 'true' ||
    el.getAttribute('data-disabled') === 'true';
  const composer = (el) =>
    el.matches({json.dumps(COMPOSER_MATCH_SELECTOR)}) ||
    Boolean(el.closest({json.dumps(COMPOSER_MATCH_SELECTOR)}));
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.getAttribute('role'),
    el.textContent
  ].filter(Boolean).join(' '));
  const selected = (el) => {{
    const target = el.closest({json.dumps(SELECTED_STATE_CLOSEST)}) || el;
    const ariaChecked = target.getAttribute('aria-checked');
    const ariaSelected = target.getAttribute('aria-selected');
    const ariaPressed = target.getAttribute('aria-pressed');
    const dataState = (target.getAttribute('data-state') || '').toLowerCase();
    return ariaChecked === 'true' || ariaSelected === 'true' || ariaPressed === 'true' ||
      ['checked', 'selected', 'on', 'active'].includes(dataState);
  }};
  const score = (label) => {{
    const lower = label.toLowerCase();
    if (lower === wanted) return 100;
    if (lower.includes(wanted)) return 90;
    if (wanted.includes(lower) && lower.length >= 8) return 60;
    return 0;
  }};
  const elements = [
    ...document.querySelectorAll({json.dumps(MENU_SCAN_CONNECTOR_CANDIDATE)})
  ];
  const matches = elements
    .map((el, index) => ({{
      el,
      index,
      label: labelOf(el),
      target: el.closest({json.dumps(MENU_TARGET_CONNECTOR)}) || el
    }}))
    .map((item) => ({{ ...item, score: score(item.label) }}))
    .filter((item) => item.score > 0 && visible(item.el) && visible(item.target) && !disabled(item.target))
    .filter((item) => !composer(item.el) && !composer(item.target))
    .sort((a, b) => b.score - a.score || a.index - b.index);
  for (const item of matches) {{
    if (selected(item.target)) {{
      return {{ ok: true, selected: true, label: item.label.slice(0, 160) }};
    }}
    try {{
      item.target.click();
      return {{ ok: true, selected: false, label: item.label.slice(0, 160) }};
    }} catch (_) {{
      continue;
    }}
  }}
  return {{ ok: false, reason: 'connector item not found' }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid connector result ({type(result).__name__})",
    }


async def click_connector_menu_candidate(page):
    try:
        buttons = await page.select_all('button[aria-haspopup="menu"]', timeout=0.5)
        for element in buttons:
            label = re.sub(r"\s+", " ", str(element.text or "")).strip()
            if label == "プラグイン" or label.lower() in {"plugin", "plugins"}:
                try:
                    position = await element.get_position()
                except Exception:
                    position = None
                if not position or position.width <= 0 or position.height <= 0:
                    continue
                await element.click_mouse()
                return {
                    "ok": True,
                    "label": (
                        f"nodriver:work-plugin:{label}"
                        f"@{position.left:.0f},{position.top:.0f}"
                    ),
                    "selector": 'button[aria-haspopup="menu"]',
                }
    except Exception:
        pass

    for selector in CONNECTOR_MENU_SELECTORS:
        try:
            element = await page.select(selector, timeout=0.25)
            if element:
                await element.click_mouse()
                return {
                    "ok": True,
                    "label": f"nodriver:{selector}",
                    "selector": selector,
                }
        except Exception:
            continue

    script = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();
  const visible = (el) => {{
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' &&
      rect.width > 0 && rect.height > 0;
  }};
  const disabled = (el) =>
    el.disabled || el.getAttribute('aria-disabled') === 'true' ||
    el.getAttribute('data-disabled') === 'true';
  const labelOf = (el) => norm([
    el.getAttribute('aria-label'),
    el.getAttribute('data-testid'),
    el.getAttribute('title'),
    el.textContent
  ].filter(Boolean).join(' '));
  const dispatchClickSequence = (target) => {{
    if (!target || !(target instanceof EventTarget)) return false;
    const types = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
    for (const type of types) {{
      const common = {{ bubbles: true, cancelable: true, view: window }};
      let event;
      if (type.startsWith('pointer') && 'PointerEvent' in window) {{
        event = new PointerEvent(type, {{
          ...common, pointerId: 1, pointerType: 'mouse', isPrimary: true
        }});
      }} else {{
        event = new MouseEvent(type, common);
      }}
      target.dispatchEvent(event);
    }}
    return true;
  }};
  const selectors = {json.dumps(CONNECTOR_MENU_SELECTORS)};
  for (const selector of selectors) {{
    const el = document.querySelector(selector);
    if (el && visible(el) && !disabled(el)) {{
      dispatchClickSequence(el);
      return {{ ok: true, label: labelOf(el).slice(0, 160), selector }};
    }}
  }}
  const labelPattern = /\\b(tools?|connectors?|plugins?|apps?|mcp)\\b|ツール|コネクタ|プラグイン|アプリ|追加|添付|ファイルなどを追加|\\+/i;
  const buttons = [...document.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})];
  for (const el of buttons) {{
    const label = labelOf(el);
    if (label && labelPattern.test(label) && visible(el) && !disabled(el)) {{
      dispatchClickSequence(el);
      return {{ ok: true, label: label.slice(0, 160), selector: 'label' }};
    }}
  }}
  return {{ ok: false, reason: 'connector menu not found' }};
}})()
"""
    result = await js(page, script)
    return js_object(result) or {
        "ok": False,
        "reason": f"invalid connector menu result ({type(result).__name__})",
    }


async def select_chat_surface(page):
    state_script = """
(() => {
  const buttons = [...document.querySelectorAll('button[role="radio"]')];
  const chat = buttons.find((el) =>
    String(el.textContent || '').replace(/\\s+/g, ' ').trim() === 'Chat'
  );
  if (!chat) return { ok: false, reason: 'Chat surface not found' };
  return {
    ok: chat.getAttribute('aria-checked') === 'true' ||
      chat.getAttribute('data-state') === 'on',
    reason: 'Chat surface inactive'
  };
})()
"""
    state = js_object(await js(page, state_script)) or {}
    if state.get("ok"):
        return True, "already-active"
    if state.get("reason") == "Chat surface not found":
        return False, state["reason"]
    try:
        element = await page.find(
            "Chat", best_match=True, return_enclosing_element=True, timeout=2
        )
        if not element:
            return False, "Chat surface element not found"
        await element.click_mouse()
        await page.sleep(1)
    except Exception as exc:
        return False, f"Chat surface click failed: {exc}"
    state = js_object(await js(page, state_script)) or {}
    if state.get("ok"):
        return True, "selected"
    return False, state.get("reason", "Chat surface selection not verified")


async def select_connector_mode(page, label, timeout):
    deadline = time.time() + timeout
    attempts = []

    def record(stage, detail):
        normalized = re.sub(r"\s+", " ", str(detail or "unknown")).strip()
        entry = f"{stage}={normalized[:500]}"
        attempts.append(entry)
        sys.stderr.write(
            "[pro-review-browser-drive] connector attempt "
            f"{len(attempts)}: {entry}\n"
        )

    pill = await verify_connector_pill(page, label)
    if pill.get("ok"):
        record("pill", "found")
        return True, f"already-pill:{label}"
    record("pill", pill.get("reason", "not found"))
    selected = await is_connector_selected(page, label)
    if selected.get("ok"):
        verified = await verify_connector_pill(page, selected.get("label", label))
        if verified.get("ok"):
            record("selected", selected.get("label", label))
            return True, f"already-selected:{selected.get('label', label)}"
        record(
            "selected-pill-missing",
            f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}",
        )
    else:
        record("selected", selected.get("reason", "not found"))
    _, editor = await wait_for_chat_input(page, min(timeout, 10))
    search_timeout = min(timeout, CONNECTOR_SEARCH_RESULT_TIMEOUT_S)
    if editor:
        ok, detail = await select_connector_via_mention(
            page, label, editor, search_timeout
        )
        if ok:
            record("mention", detail)
            return True, detail
        record("mention", detail)
        ok, detail = await select_connector_via_menu_search(
            page, label, search_timeout
        )
        if ok:
            record("search", detail)
            return True, detail
        record("search", detail)
    else:
        record("search", "composer not found")
    first = await click_connector_candidate(page, label)
    if first.get("ok"):
        await page.sleep(0.5)
        verified = await verify_connector_pill(page, first.get("label", label))
        if verified.get("ok"):
            record("visible", first.get("label", label))
            return True, f"visible:{first.get('label', label)}"
        record(
            "visible-pill-missing",
            f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}",
        )
    else:
        record("visible", first.get("reason", "not found"))
    menu_rounds = 0
    while time.time() < deadline and menu_rounds < 3:
        menu_rounds += 1
        opened = await click_connector_menu_candidate(page)
        if not opened.get("ok"):
            record("menu", opened.get("reason", "not found"))
            break
        record("menu", opened.get("label", "opened"))
        await page.sleep(0.8)
        selected = await is_connector_selected(page, label)
        if selected.get("ok"):
            verified = await verify_connector_pill(page, selected.get("label", label))
            if verified.get("ok"):
                record("menu-selected", selected.get("label", label))
                return True, f"selected:{selected.get('label', label)}"
            record(
                "menu-selected-pill-missing",
                f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}",
            )
        else:
            record("menu-selected", selected.get("reason", "not found"))
        clicked = await click_connector_candidate(page, label)
        if clicked.get("ok"):
            await page.sleep(0.5)
            verified = await verify_connector_pill(page, clicked.get("label", label))
            if verified.get("ok"):
                record("menu-click", clicked.get("label", label))
                return True, f"menu:{opened.get('label', '')}->{clicked.get('label', label)}"
            record(
                "menu-click-pill-missing",
                f"pill={verified.get('hasPill')},label={verified.get('hasLabel')}",
            )
        else:
            record(
                "menu-click",
                f"{opened.get('label', '')}->{clicked.get('reason', 'connector item not found')}",
            )
        await page.sleep(0.5)
    return False, " | ".join(attempts)


async def select_deep_research_via_slash(page, timeout):
    _, editor = await wait_for_chat_input(page, min(timeout, 10))
    if not editor:
        return False, "composer not found"
    attempts = []
    for command in ("/Deepresearch", "/Deep Research"):
        await clear_prompt(page)
        try:
            await editor.click()
            await editor.send_keys(command)
        except Exception as exc:
            attempts.append(f"{command}:send_keys:{exc}")
            continue
        await page.sleep(1)
        clicked = await click_deep_research_candidate(page)
        await page.sleep(0.5)
        if clicked.get("ok"):
            return True, f"slash:{clicked.get('label', command)}"
        await clear_prompt(page)
        attempts.append(f"{command}:{clicked.get('reason', 'not found')}")
    return False, "; ".join(attempts)


async def select_deep_research_via_tools_menu(page):
    await clear_prompt(page)
    first = await click_deep_research_candidate(page)
    if first.get("ok"):
        return True, f"visible:{first.get('label', '')}"
    opened = await click_tools_menu_candidate(page)
    if not opened.get("ok"):
        await clear_prompt(page)
        return False, opened.get("reason", "tools menu not found")
    await page.sleep(0.8)
    second = await click_deep_research_candidate(page)
    await page.sleep(0.3)
    if second.get("ok"):
        return True, f"tools:{second.get('label', '')}"
    await clear_prompt(page)
    return False, f"tools opened ({opened.get('label', '')}); {second.get('reason', 'item not found')}"


async def select_deep_research_mode(page, timeout):
    attempts = []
    ok, detail = await select_deep_research_via_slash(page, timeout)
    if ok:
        return True, detail
    attempts.append(f"slash={detail}")
    ok, detail = await select_deep_research_via_tools_menu(page)
    if ok:
        return True, detail
    attempts.append(f"tools={detail}")
    return False, " | ".join(attempts)


# 2026-07 UI: モデル選択は「チップ → 詳細設定 → 思考レベル」の submenu。
# 選択は draft 単位で新規セッションに引き継がれないため、送信前に毎回選ぶ。
THINKING_LEVEL_CHOICES = ("off", "軽", "中程度", "高い", "非常に高い", "最大", "ウルトラ")

MODEL_CHIP_RECT_JS = """
(() => {
  const els = [...document.querySelectorAll('button,[role="button"]')]
    .filter((el) => /\\d\\.\\d/.test(el.textContent || '') && (el.textContent || '').trim().length < 40);
  if (!els.length) return JSON.stringify({ ok: false, reason: 'model chip not found' });
  els.sort((a, b) => (a.textContent || '').length - (b.textContent || '').length);
  const r = els[0].getBoundingClientRect();
  return JSON.stringify({ ok: true, x: r.x + r.width / 2, y: r.y + r.height / 2,
    text: (els[0].textContent || '').replace(/\\s+/g, ' ').trim() });
})()
"""

MENU_ACTIVE_ELEMENT_JS = """
(() => {
  const el = document.activeElement;
  if (!el) return JSON.stringify({ text: '', role: '', expanded: '' });
  return JSON.stringify({
    text: (el.textContent || '').replace(/\\s+/g, ' ').trim().slice(0, 80),
    role: el.getAttribute('role') || el.tagName.toLowerCase(),
    expanded: el.getAttribute('aria-expanded') || '',
  });
})()
"""

_MENU_NAV_KEY_CODES = {"ArrowDown": 40, "ArrowRight": 39, "Enter": 13, "Escape": 27}


async def press_menu_nav_key(page, key):
    from nodriver import cdp

    kwargs = {
        "key": key,
        "code": key,
        "windows_virtual_key_code": _MENU_NAV_KEY_CODES[key],
        "native_virtual_key_code": _MENU_NAV_KEY_CODES[key],
    }
    if key == "Enter":
        kwargs["text"] = "\r"
    await page.send(cdp.input_.dispatch_key_event(type_="rawKeyDown", **kwargs))
    await page.send(cdp.input_.dispatch_key_event(type_="keyUp", **kwargs))


async def _menu_active_element(page):
    return js_object(await js(page, MENU_ACTIVE_ELEMENT_JS)) or {}


async def _close_menu(page):
    await press_menu_nav_key(page, "Escape")
    await page.sleep(0.3)
    await press_menu_nav_key(page, "Escape")


async def select_thinking_level(page, level):
    """チップは実クリック、以降は keyboard navigation で辿る。

    popover は composer 再配置で座標がずれるため、行の座標クリックは使わない。
    """
    chip = js_object(await js(page, MODEL_CHIP_RECT_JS)) or {}
    if not chip.get("ok"):
        return False, chip.get("reason", "model chip not found")
    await page.mouse_click(chip["x"], chip["y"])
    await page.sleep(1.2)
    reached = False
    for _ in range(12):
        await press_menu_nav_key(page, "ArrowDown")
        await page.sleep(0.35)
        active = await _menu_active_element(page)
        text = active.get("text") or ""
        if text == "詳細設定" and active.get("expanded") == "false":
            await press_menu_nav_key(page, "Enter")
            await page.sleep(0.7)
            active = await _menu_active_element(page)
            text = active.get("text") or ""
        if text.startswith("思考レベル"):
            reached = True
            break
    if not reached:
        await _close_menu(page)
        return False, "thinking-level row not reachable via keyboard"
    await press_menu_nav_key(page, "ArrowRight")
    await page.sleep(0.7)
    picked = None
    seen = []
    for _ in range(10):
        active = await _menu_active_element(page)
        text = active.get("text") or ""
        if text.startswith(level):
            picked = text
            break
        if text in seen:
            break
        seen.append(text)
        await press_menu_nav_key(page, "ArrowDown")
        await page.sleep(0.35)
    if picked is None:
        await _close_menu(page)
        return False, f"level '{level}' not in submenu: {seen}"
    await press_menu_nav_key(page, "Enter")
    await page.sleep(1.0)
    chip_after = js_object(await js(page, MODEL_CHIP_RECT_JS)) or {}
    chip_text = (chip_after.get("text") or "").replace(" ", "")
    if level in chip_text:
        return True, f"chip={chip_after.get('text')}"
    return False, f"chip mismatch after selection: {chip_after.get('text')}"


async def wait_for_chat_input(page, timeout):
    selectors = COMPOSER_QUERY_SELECTORS
    deadline = time.time() + timeout
    while time.time() < deadline:
        for selector in selectors:
            try:
                element = await page.query_selector(selector)
            except Exception:
                element = None
            if element:
                return selector, element
        await page.sleep(0.5)
    return None, None


# send_keys は1文字ずつ入力するため、巨大な依頼文では実質ハングする。
# fill_prompt(JS注入)失敗時の最後の手段としてのみ、この上限以下で使う。
SEND_KEYS_MAX_CHARS = 2000

# 入力欄に実際に入った文字数を読む。fill_prompt の返り値型が環境差で
# dict にならない場合でも、DOM 実体で注入成功を確認するために使う。
PROMPT_LENGTH_JS = f"""
(() => {{
  const selectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const el = selectors.map(s => document.querySelector(s)).find(Boolean);
  if (!el) return {{ ok: false, length: 0 }};
  return {{ ok: true, length: (el.value || el.textContent || '').length }};
}})()
"""


async def fill_prompt(page, request_text):
    payload = json.dumps(request_text)
    script = f"""
(() => {{
  const text = {payload};
  const selectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const el = selectors.map(s => document.querySelector(s)).find(Boolean);
  if (!el) return {{ ok: false, reason: 'input not found' }};
  el.focus();
  if (el.tagName === 'TEXTAREA' || el.tagName === 'INPUT') {{
    el.value = text;
  }} else {{
    el.textContent = text;
  }}
  el.dispatchEvent(new InputEvent('input', {{
    bubbles: true,
    cancelable: true,
    inputType: 'insertText',
    data: text
  }}));
  el.dispatchEvent(new Event('change', {{ bubbles: true }}));
  return {{
    ok: true,
    tag: el.tagName,
    length: (el.value || el.textContent || '').length
  }};
}})()
"""
    return await js(page, script)


async def fill_prompt_preserve_pill(page, editor, request_text):
    """connector pill を壊さず send_keys で追記する。"""
    if len(request_text) > SEND_KEYS_MAX_CHARS:
        return False, f"request too large for send_keys ({len(request_text)}>{SEND_KEYS_MAX_CHARS})"
    baseline = js_object(await js(page, PROMPT_LENGTH_JS)) or {}
    base_len = int(baseline.get("length") or 0)
    try:
        await editor.click()
        await editor.send_keys(request_text)
    except Exception as exc:
        return False, f"send_keys failed: {exc}"
    verify = js_object(await js(page, PROMPT_LENGTH_JS)) or {}
    new_len = int(verify.get("length") or 0)
    if new_len <= base_len:
        return False, f"no prompt increment (base={base_len}, now={new_len})"
    return True, f"appended:{base_len}->{new_len}"


async def wait_send_enabled(page, timeout):
    """添付アップロード完了まで send-button が disabled のことがある。有効化を待つ。"""
    deadline = time.time() + timeout
    while time.time() < deadline:
        state = js_object(await js(page, SEND_READY_JS)) or {}
        if state.get("ready"):
            return True, state.get("reason", "ready")
        await page.sleep(0.5)
    state = js_object(await js(page, SEND_READY_JS)) or {}
    return False, state.get("reason", "send button not enabled")


SEND_READY_JS = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const editorSelectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const editor = editorSelectors.map(s => document.querySelector(s)).find(Boolean);
  const scopes = [];
  if (editor) {{
    const scoped = editor.closest('form') || editor.closest('[class*="composer"]');
    if (scoped) scopes.push(scoped);
  }}
  scopes.push(document);
  const score = (button) => {{
    const label = norm([
      button.getAttribute('aria-label') || '',
      button.getAttribute('data-testid') || '',
      button.textContent || ''
    ].join(' '));
    if (button.getAttribute('data-testid') === 'send-button') return 5;
    if (label.includes('send-button')) return 4;
    if (label.includes('send prompt')) return 3;
    if (label.includes('send message')) return 3;
    if (label === 'send' || label.includes(' send ')) return 2;
    if (label.includes('送信')) return 2;
    return 0;
  }};
  for (const scope of scopes) {{
    const candidates = [...scope.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})];
    const button = candidates.sort((a, b) => score(b) - score(a)).find(b => score(b) > 0);
    if (!button) continue;
    const disabled = button.disabled || button.getAttribute('aria-disabled') === 'true';
    if (!disabled) return {{ ready: true, reason: 'send-button enabled' }};
    return {{ ready: false, reason: 'send-button disabled (upload/processing?)' }};
  }}
  return {{ ready: false, reason: 'send button not found' }};
}})()
"""


# 送信ボタンの探索: composer 配下を優先し、見つからなければ document 全体へフォールバック。
CLICK_SEND_JS = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const editorSelectors = {json.dumps(COMPOSER_QUERY_SELECTORS)};
  const editor = editorSelectors.map(s => document.querySelector(s)).find(Boolean);
  const scopes = [];
  if (editor) {{
    const scoped = editor.closest('form') || editor.closest('[class*="composer"]');
    if (scoped) scopes.push(scoped);
  }}
  scopes.push(document);
  const score = (button) => {{
    const label = norm([
      button.getAttribute('aria-label') || '',
      button.getAttribute('data-testid') || '',
      button.textContent || ''
    ].join(' '));
    if (button.disabled || button.getAttribute('aria-disabled') === 'true') return 0;
    if (button.getAttribute('data-testid') === 'send-button') return 5;
    if (label.includes('send-button')) return 4;
    if (label.includes('send prompt')) return 3;
    if (label.includes('send message')) return 3;
    if (label === 'send' || label.includes(' send ')) return 2;
    if (label.includes('送信')) return 2;
    return 0;
  }};
  for (const scope of scopes) {{
    const candidates = [...scope.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})];
    const button = candidates.sort((a, b) => score(b) - score(a)).find(b => score(b) > 0);
    if (button) {{
      button.click();
      return {{ ok: true }};
    }}
  }}
  return {{ ok: false, reason: 'button not found' }};
}})()
"""

# クリック前後の状態を比較するためのベースライン/確認シグナル。
# 「クリックできた」ではなく「実際に送信状態へ遷移したか」で成功判定する。
SEND_BASELINE_JS = """
(() => {
  const userTurns = document.querySelectorAll('[data-message-author-role="user"]').length;
  return { userTurns };
})()
"""

SEND_CONFIRM_JS = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const userTurns = document.querySelectorAll('[data-message-author-role="user"]').length;
  const stopBtn = [...document.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})].some((el) => {{
    const aria = norm(el.getAttribute('aria-label'));
    const testid = norm(el.getAttribute('data-testid'));
    const text = norm(el.textContent);
    return /stop-button|stop-generation|stop-response/.test(testid)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(aria)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(text);
  }});
  return {{ userTurns, stopBtn }};
}})()
"""


async def click_send(page, timeout):
    """送信ボタンをクリックし、user message 増加 or 生成中ボタン出現の
    どちらかで送信完了を確認してから (True, reason) を返す。クリックできた
    だけ（button.click() が例外を投げなかっただけ）では成功にしない。"""
    baseline = js_object(await js(page, SEND_BASELINE_JS)) or {}
    baseline_turns = int(baseline.get("userTurns") or 0)
    deadline = time.time() + timeout
    ever_clicked = False
    while time.time() < deadline:
        result = js_object(await js(page, CLICK_SEND_JS)) or {}
        if not result.get("ok"):
            await page.sleep(0.5)
            continue
        ever_clicked = True
        confirm_deadline = min(deadline, time.time() + 3)
        while time.time() < confirm_deadline:
            state = js_object(await js(page, SEND_CONFIRM_JS)) or {}
            if int(state.get("userTurns") or 0) > baseline_turns or state.get("stopBtn"):
                return True, "confirmed"
            await page.sleep(0.3)
    if ever_clicked:
        return False, "clicked but no state transition observed"
    return False, "send button not found"


def read_clipboard():
    """OS クリップボードを読む（mac=pbpaste）。取得できなければ None。"""
    try:
        out = subprocess.run(["pbpaste"], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.decode("utf-8", "replace")


def count_download_matches(stem):
    """~/Downloads 内で stem に一致するファイル数。誤クリック download 連打の検知用。"""
    if not stem:
        return 0
    downloads = os.path.expanduser("~/Downloads")
    if not os.path.isdir(downloads):
        return 0
    try:
        names = os.listdir(downloads)
    except OSError:
        return 0
    return sum(1 for name in names if name.startswith(stem))


def download_guard_stem(request_file):
    """添付 packet の basename stem（拡張子なし）。Downloads 連打検知のキー。"""
    if not request_file:
        return None
    base = os.path.basename(request_file)
    if not base:
        return None
    stem, _ext = os.path.splitext(base)
    return stem or None


# ChatGPT の会話は window ではなく内側コンテナがスクロールする。
# window.scrollTo だけでは最下部のコピーボタンに届かないことがある。
SCROLL_CONVERSATION_BOTTOM_JS = """
(() => {
  const turns = [...document.querySelectorAll('[data-message-author-role="assistant"]')];
  const last = turns.length ? turns[turns.length - 1] : null;
  const roots = [
    document.querySelector('[data-testid="chat-thread"]'),
    document.querySelector('section[data-testid="screen-threadFlyOut"]'),
    document.querySelector('main'),
    document.querySelector('[role="main"]'),
  ].filter(Boolean);
  const candidates = new Set(roots);
  let el = last;
  while (el && el !== document.body && el !== document.documentElement) {
    try {
      const style = window.getComputedStyle(el);
      const oy = style.overflowY || '';
      if (
        (oy === 'auto' || oy === 'scroll' || oy === 'overlay') &&
        el.scrollHeight > el.clientHeight + 8
      ) {
        candidates.add(el);
      }
    } catch (_) {}
    el = el.parentElement;
  }
  let scrolled = 0;
  for (const node of candidates) {
    try {
      const before = node.scrollTop;
      node.scrollTop = node.scrollHeight;
      if (node.scrollTop !== before) scrolled += 1;
    } catch (_) {}
  }
  if (last) {
    try {
      last.scrollIntoView({ block: 'end', inline: 'nearest' });
    } catch (_) {}
  }
  try {
    const h = Math.max(
      document.body ? document.body.scrollHeight : 0,
      document.documentElement ? document.documentElement.scrollHeight : 0
    );
    window.scrollTo(0, h);
  } catch (_) {}
  return { scrolledContainers: scrolled, hasAssistant: Boolean(last) };
})()
"""


# 最後の assistant 回答の「コピー」ボタンを押す。ChatGPT は整形済み Markdown を
# OS クリップボードに入れるので、DOM 解析より取りこぼしが少ない。
# Oracle: button[data-testid="copy-turn-action-button"] が正本。
# 探索は最後の assistant turn 内(+直後 sibling)のみ。親へ広げると user 添付の
# download を誤クリックし Downloads に packet が連打される（2026-07-09 実機事故）。
# クリックは pointer/mouse シーケンス + clipboard intercept。単純 click()+pbpaste だと
# 自動化コンテキストで clipboard が空のまま連打される（人間の手動コピーで「成功」に見えた）。
COPY_LAST_REPLY_JS = """
(() => {
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const TIMEOUT_MS = 8000;

  function dispatchClickSequence(target) {
    if (!target || !(target instanceof EventTarget)) return false;
    const types = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'];
    for (const type of types) {
      const common = { bubbles: true, cancelable: true, view: window };
      let event;
      if (type.startsWith('pointer') && 'PointerEvent' in window) {
        event = new PointerEvent(type, { ...common, pointerId: 1, pointerType: 'mouse' });
      } else {
        event = new MouseEvent(type, common);
      }
      target.dispatchEvent(event);
    }
    return true;
  }

  const turns = [...document.querySelectorAll('[data-message-author-role="assistant"]')];
  if (!turns.length) return Promise.resolve({ ok: false, reason: 'no assistant message' });
  const last = turns[turns.length - 1];
  const article =
    last.closest('article') ||
    last.closest('[data-testid*="conversation-turn"]') ||
    last.closest('[data-turn]') ||
    last;
  const scopes = [last, article];
  let sib = article.nextElementSibling;
  for (let i = 0; i < 2 && sib; i += 1, sib = sib.nextElementSibling) {
    if (sib.querySelector?.('[data-message-author-role="user"]')) break;
    if (sib.getAttribute?.('data-message-author-role') === 'user') break;
    scopes.push(sib);
  }
  const inUser = (el) => Boolean(el.closest('[data-message-author-role="user"]'));

  let btn = null;
  let via = '';
  for (const scope of scopes) {
    if (!scope) continue;
    const official = [...scope.querySelectorAll('button[data-testid="copy-turn-action-button"]')]
      .filter((el) => !inUser(el));
    if (official.length) {
      btn = official[official.length - 1];
      via = 'copy-turn-action-button';
      break;
    }
  }
  if (!btn) {
    const seen = new Set();
    const buttons = [];
    for (const scope of scopes) {
      if (!scope) continue;
      for (const el of scope.querySelectorAll(__BUTTON_ROLE_SELECTOR__)) {
        if (seen.has(el)) continue;
        seen.add(el);
        buttons.push(el);
      }
    }
    const labelOf = (el) => norm([
      el.getAttribute('aria-label'),
      el.getAttribute('data-testid'),
      el.getAttribute('title'),
      el.textContent
    ].filter(Boolean).join(' '));
    const matches = buttons.filter((el) => {
      if (inUser(el)) return false;
      if (el.hasAttribute('download')) return false;
      const label = labelOf(el);
      if (!label) return false;
      if (/download|ダウンロード|保存して|save file|添付/.test(label)) return false;
      if (/code|コード/.test(label)) return false;
      return /\\bcopy\\b|コピー|copy response|copy message|メッセージをコピー|copy-turn-action/.test(label);
    });
    if (matches.length) {
      btn = matches[matches.length - 1];
      via = 'assistant-copy-label';
    }
  }
  if (!btn) {
    return Promise.resolve({ ok: false, reason: 'copy button not found', scopes: scopes.length });
  }

  const clipboard = navigator.clipboard;
  const state = { text: '', updatedAt: 0 };
  let restore = () => {};
  if (clipboard) {
    const originalWriteText = clipboard.writeText?.bind(clipboard);
    const originalWrite = clipboard.write?.bind(clipboard);
    clipboard.writeText = (value) => {
      state.text = typeof value === 'string' ? value : '';
      state.updatedAt = Date.now();
      return Promise.resolve();
    };
    clipboard.write = async (items) => {
      try {
        const list = Array.isArray(items) ? items : items ? [items] : [];
        for (const item of list) {
          if (!item) continue;
          const types = Array.isArray(item.types) ? item.types : [];
          if (types.includes('text/plain') && typeof item.getType === 'function') {
            const blob = await item.getType('text/plain');
            state.text = (await blob.text()) ?? '';
            state.updatedAt = Date.now();
            break;
          }
        }
      } catch (_) {
        state.text = '';
        state.updatedAt = Date.now();
      }
      return Promise.resolve();
    };
    restore = () => {
      if (originalWriteText) clipboard.writeText = originalWriteText;
      if (originalWrite) clipboard.write = originalWrite;
    };
  }

  return new Promise((resolve) => {
    let settled = false;
    let pollId = null;
    let timeoutId = null;
    const finish = (payload) => {
      if (settled) return;
      settled = true;
      if (pollId) clearInterval(pollId);
      if (timeoutId) clearTimeout(timeoutId);
      try { restore(); } catch (_) {}
      resolve(payload);
    };
    let lastText = '';
    let stableTicks = 0;
    const maybeFinish = () => {
      const markdown = state.text || '';
      if (!markdown.trim()) return;
      if (markdown !== lastText) {
        lastText = markdown;
        stableTicks = 0;
        return;
      }
      stableTicks += 1;
      const ageMs = Date.now() - (state.updatedAt || 0);
      if (stableTicks >= 3 && ageMs >= 250) {
        finish({ ok: true, via, markdown, intercepted: true });
      }
    };
    try { btn.scrollIntoView({ block: 'center', behavior: 'instant' }); } catch (_) {}
    dispatchClickSequence(btn);
    pollId = setInterval(maybeFinish, 120);
    timeoutId = setTimeout(() => {
      finish({
        ok: false,
        reason: state.text ? 'clipboard unstable' : 'clipboard empty after copy',
        via,
        intercepted: Boolean(state.text),
      });
    }, TIMEOUT_MS);
  });
})()
"""
COPY_LAST_REPLY_JS = COPY_LAST_REPLY_JS.replace(
    "__BUTTON_ROLE_SELECTOR__",
    json.dumps(BUTTON_ROLE_SELECTOR),
)


# 応答が生成中(停止ボタン表示)かを判定。生成中にコピーすると途中で拾うため待つ。
# あわせて、最終 assistant ターン近傍のステータス文言(経過時間・「Thinking」等)を
# liveness signal として拾う。取得できなくても generating 判定自体には影響しない。
IS_GENERATING_JS = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const btns = [...document.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})];
  const generating = btns.some((el) => {{
    const aria = norm(el.getAttribute('aria-label'));
    const testid = norm(el.getAttribute('data-testid'));
    const text = norm(el.textContent);
    return /stop-button|stop-generation|stop-response/.test(testid)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(aria)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(text);
  }});
  let status = '';
  const turns = [...document.querySelectorAll('[data-message-author-role="assistant"]')];
  const last = turns[turns.length - 1];
  if (last) {{
    const scope = last.closest('article') || last.parentElement || last;
    const text = (scope.textContent || '').replace(/\\s+/g, ' ').trim();
    const m = text.match(/(thinking|thought for|考え中|回答を確定中|生成中)[^.。\\n]{{0,40}}/i)
      || text.match(/\\b\\d{{1,2}}:\\d{{2}}\\b/)
      || text.match(/\\d+\\s*(秒|分|sec|s|min)\\b/i);
    if (m) status = m[0].slice(0, 60);
  }}
  return {{ generating, status }};
}})()
"""

# Oracle-derived snapshot: enough signal to decide timeout vs recover vs retry
# without guessing from silence alone.
BROWSER_STATE_JS = f"""
(() => {{
  const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
  const btns = [...document.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})];
  const generating = btns.some((el) => {{
    const aria = norm(el.getAttribute('aria-label'));
    const testid = norm(el.getAttribute('data-testid'));
    const text = norm(el.textContent);
    return /stop-button|stop-generation|stop-response/.test(testid)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(aria)
      || /^(stop generating|stop streaming|生成を停止|回答を停止|ストリーミングを停止|停止)$/.test(text);
  }});
  let status = '';
  const turns = [...document.querySelectorAll('[data-message-author-role="assistant"]')];
  const last = turns[turns.length - 1];
  if (last) {{
    const scope = last.closest('article') || last.parentElement || last;
    const text = (scope.textContent || '').replace(/\\s+/g, ' ').trim();
    const m = text.match(/(thinking|thought for|考え中|回答を確定中|生成中|pro thinking|finalizing|researching|searching)[^.。\\n]{{0,40}}/i)
      || text.match(/\\b\\d{{1,2}}:\\d{{2}}\\b/)
      || text.match(/\\d+\\s*(秒|分|sec|s|min)\\b/i);
    if (m) status = m[0].slice(0, 60);
  }}
  const userTurns = document.querySelectorAll('[data-message-author-role="user"]').length;
  const assistantTurns = turns.length;
  const loginRequired = Boolean(
    document.querySelector('[data-testid="login-button"], button[data-testid="login-button"]')
  );
  const composerVisible = Boolean(
    document.querySelector({json.dumps(COMPOSER_QUERY_SELECTOR_CSV)})
  );
  let copyButtonVisible = false;
  if (last) {{
    const article =
      last.closest('article') ||
      last.closest('[data-testid*="conversation-turn"]') ||
      last.closest('[data-turn]') ||
      last;
    const scopes = [last, article];
    let sib = article.nextElementSibling;
    for (let i = 0; i < 2 && sib; i += 1, sib = sib.nextElementSibling) {{
      if (sib.querySelector?.('[data-message-author-role="user"]')) break;
      if (sib.getAttribute?.('data-message-author-role') === 'user') break;
      scopes.push(sib);
    }}
    for (const scope of scopes) {{
      if (!scope) continue;
      if (scope.querySelector('button[data-testid="copy-turn-action-button"]')) {{
        copyButtonVisible = true;
        break;
      }}
    }}
    if (!copyButtonVisible) {{
      const seen = new Set();
      const buttons = [];
      for (const scope of scopes) {{
        if (!scope) continue;
        for (const btn of scope.querySelectorAll({json.dumps(BUTTON_ROLE_SELECTOR)})) {{
          if (seen.has(btn)) continue;
          seen.add(btn);
          buttons.push(btn);
        }}
      }}
      copyButtonVisible = buttons.some((btn) => {{
        if (btn.closest('[data-message-author-role="user"]')) return false;
        if (btn.hasAttribute('download')) return false;
        const label = norm([
          btn.getAttribute('aria-label'),
          btn.getAttribute('data-testid'),
          btn.getAttribute('title'),
          btn.textContent
        ].filter(Boolean).join(' '));
        if (/download|ダウンロード|添付/.test(label)) return false;
        return /\\bcopy\\b|コピー/.test(label) && !/code|コード|download|ダウンロード/.test(label);
      }});
    }}
  }}
  return {{
    generating,
    status,
    userTurns,
    assistantTurns,
    loginRequired,
    composerVisible,
    copyButtonVisible
  }};
}})()
"""


def is_answer_now_placeholder(text):
    """Oracle learned: Pro thinking placeholder turns are not final answers."""
    normalized = re.sub(r"\s+", " ", (text or "")).strip().lower()
    if not normalized:
        return False
    if normalized in ("chatgpt said:", "chatgpt said"):
        return True
    if (
        "file upload request" in normalized
        and ("pro thinking" in normalized or "chatgpt said" in normalized)
    ):
        return True
    return "answer now" in normalized and (
        "pro thinking" in normalized or "chatgpt said" in normalized
    )


async def read_browser_state(page):
    return js_object(await js(page, BROWSER_STATE_JS)) or {}


async def extract_via_copy(page, run_id, timeout, request_file=None):
    """コピーボタン→クリップポードで最終回答を取得し marker 検証する。"""
    deadline = time.time() + timeout
    started = time.time()
    last_error = ""
    tick = 0
    stem = download_guard_stem(request_file)
    baseline_downloads = count_download_matches(stem) if stem else 0
    while time.time() < deadline:
        if stem:
            current = count_download_matches(stem)
            if current > baseline_downloads + 1:
                # コピー誤クリックで packet が Downloads に連打されている。即停止。
                sys.stderr.write(
                    f"[pro-review-browser-drive] download flood detected:"
                    f" {stem}* count={current} (baseline={baseline_downloads})\n"
                )
                state = await read_browser_state(page)
                return None, "download flood (misclicked attachment)", state
        gen = js_object(await js(page, IS_GENERATING_JS)) or {}
        if gen.get("generating"):
            tick += 1
            if tick % 5 == 1:
                # 単なる無出力タイムアウトだと「止まっているのか進んでいるのか」
                # 区別できないため、経過秒数(+拾えれば ChatGPT 側のステータス文言)を
                # liveness signal として定期的に stderr へ出す。
                elapsed = int(time.time() - started)
                status = gen.get("status") or ""
                suffix = f" ({status})" if status else ""
                sys.stderr.write(
                    f"[pro-review-browser-drive] generating... {elapsed}s elapsed{suffix}\n"
                )
            await page.sleep(2)
            continue
        # 会話コンテナ(内側スクロール)を最下部へ。window.scrollTo だけでは届かない。
        scroll_info = js_object(await js(page, SCROLL_CONVERSATION_BOTTOM_JS)) or {}
        if tick % 5 == 0:
            sys.stderr.write(
                "[pro-review-browser-drive] scroll bottom:"
                f" containers={scroll_info.get('scrolledContainers', 0)}\n"
            )
        await page.sleep(0.4)  # アクションバー遅延マウント待ち
        clicked = js_object(await js(page, COPY_LAST_REPLY_JS)) or {}
        if not clicked.get("ok"):
            last_error = clicked.get("reason", "copy button not found")
            sys.stderr.write(f"[pro-review-browser-drive] copy retry: {last_error}\n")
            await page.sleep(2)
            continue
        via = clicked.get("via") or "copy"
        intercepted = bool(clicked.get("intercepted"))
        sys.stderr.write(
            f"[pro-review-browser-drive] copy clicked via={via}"
            f" intercepted={'yes' if intercepted else 'no'}\n"
        )
        # 優先: JS 内 clipboard intercept の本文。失敗時のみ OS pbpaste にフォールバック。
        clip = clicked.get("markdown") if intercepted else None
        if not clip:
            await page.sleep(0.3)
            clip = read_clipboard()
            if clip:
                sys.stderr.write("[pro-review-browser-drive] clipboard via pbpaste fallback\n")
        if clip:
            if is_answer_now_placeholder(clip):
                last_error = "assistant placeholder (answer now / pro thinking)"
                sys.stderr.write(
                    f"[pro-review-browser-drive] copy retry: {last_error}\n"
                )
                await page.sleep(2)
                continue
            try:
                return validate_reply(clip, run_id), None, None
            except ValueError as exc:
                last_error = str(exc)
        else:
            last_error = "clipboard empty after copy"
            sys.stderr.write(
                f"[pro-review-browser-drive] copy retry: {last_error}\n"
            )
        await page.sleep(2)
    state = await read_browser_state(page)
    if state.get("generating"):
        return None, "response still generating", state
    return None, last_error or "timeout waiting for copy", state


async def extract_via_dom(page, run_id, timeout):
    deadline = time.time() + timeout
    last_error = ""
    while time.time() < deadline:
        content = await page.get_content()
        parser = AssistantParser()
        parser.feed(content)
        if parser.login_required:
            return None, "login required"
        if parser.messages:
            reply = html.unescape(parser.messages[-1])
            try:
                return validate_reply(reply, run_id), None
            except ValueError as exc:
                last_error = str(exc)
        await page.sleep(2)
    return None, last_error or "timeout waiting for DONE marker"


async def extract_live_reply(page, run_id, timeout, request_file=None):
    """主経路=コピーボタン、失敗時に DOM 解析へフォールバック。"""
    deadline = time.time() + timeout
    # まずコピー経路に大半の時間を与え、ダメなら残り時間で DOM 経路を試す。
    copy_budget = max(timeout - 20, timeout * 0.8)
    reply, reason, copy_state = await extract_via_copy(
        page, run_id, copy_budget, request_file=request_file
    )
    if reply is not None:
        sys.stderr.write("[pro-review-browser-drive] reply via copy button\n")
        return reply, None, None
    if reason == "login required":
        return None, reason, copy_state
    if reason and "download flood" in reason:
        # 誤クリック連打は DOM fallback でも同じボタンを押し続ける危険があるので即停止。
        return None, reason, copy_state
    remaining = max(deadline - time.time(), 5)
    sys.stderr.write(
        f"[pro-review-browser-drive] copy extraction failed ({reason}); falling back to DOM scrape\n"
    )
    dom_reply, dom_reason = await extract_via_dom(page, run_id, remaining)
    if dom_reply is not None:
        return dom_reply, None, None
    state = copy_state or await read_browser_state(page)
    return None, dom_reason or reason, state


async def find_file_input(page):
    try:
        return await page.select("input[type=file]", timeout=3)
    except Exception:
        return None


def attachment_evidence_js(filename):
    """ファイル名(先頭40字)が DOM 上のどこかに現れたかを見る、添付完了の目視確認用 JS。
    ChatGPT 側のチップ要素の class/testid は変動しうるので特定セレクタに賭けず、
    body 全体のテキスト検索という壊れにくい方法に倒す。"""
    payload = json.dumps(filename[:40])
    return f"""
(() => {{
  const needle = ({payload}).toLowerCase();
  if (!needle) return {{ found: false }};
  const body = document.body ? (document.body.textContent || '') : '';
  return {{ found: body.toLowerCase().includes(needle) }};
}})()
"""


async def wait_attachment_evidence(page, filename, timeout):
    """添付ファイル名が画面上に現れるまで待つ。見つからなくても送信自体は
    続行し、loud warning に留める（セレクタの当て推量で正常経路を壊さないため）。"""
    deadline = time.time() + timeout
    while time.time() < deadline:
        state = js_object(await js(page, attachment_evidence_js(filename))) or {}
        if state.get("found"):
            return True
        await page.sleep(0.5)
    return False


async def attach_request_file(page, request_path):
    """packet(.md) を ChatGPT に添付する。失敗時は False を返し直書きへフォールバック。"""
    file_input = await find_file_input(page)
    if file_input is None:
        opened = js_object(await click_tools_menu_candidate(page)) or {}
        if opened.get("ok"):
            await page.sleep(0.5)
            file_input = await find_file_input(page)
    if file_input is None:
        return False, "file input not found"
    try:
        await file_input.send_file(request_path)
    except Exception as exc:
        return False, f"send_file failed: {exc}"
    filename = os.path.basename(request_path)
    confirmed = await wait_attachment_evidence(page, filename, 15)
    if not confirmed:
        sys.stderr.write(
            f"[pro-review-browser-drive] ⚠ attach unconfirmed: filename '{filename}' "
            "not detected on page within 15s; proceeding anyway (verify manually if send fails)\n"
        )
    return True, "attached" if confirmed else "attached (unconfirmed)"


def compose_attach_instruction(request_text, run_id, filename):
    """添付時に入力欄へ入れる短い指示文。観点とマーカー要件だけを伝える。"""
    review = markdown_section(request_text, "レビュー観点").strip()
    lines = [
        f"添付した Markdown ファイル `{filename}` がレビュー依頼です。",
        "ファイル内の指示・対象コード・観点に従ってレビューしてください。",
    ]
    if review:
        first = review.splitlines()[0].strip()
        if first:
            lines.append(f"観点: {first}")
    lines.append(
        f"回答の最終行に必ず `[[DONE-{run_id}]]` を単独で記載してください（完了検知に使います）。"
    )
    return "\n".join(lines)


def extract_from_reply_file(path, run_id):
    """--fixture-reply: コピー取得をモックした reply 本文を検証して出力する。"""
    try:
        with open(path, "r", encoding="utf-8") as f:
            reply = f.read()
    except OSError as exc:
        sys.stderr.write(f"[pro-review-browser-drive] cannot read reply fixture: {exc}\n")
        return 2
    try:
        print(validate_reply(reply, run_id))
        return 0
    except ValueError as exc:
        sys.stderr.write(f"[pro-review-browser-drive] error: {exc}\n")
        return 2


def classify_live_error(exc):
    text = str(exc).lower()
    profile_lock_terms = [
        "user data directory is already in use",
        "profile appears to be in use",
        "singletonlock",
        "singletoncookie",
        "process singleton",
        "cannot create default profile directory",
    ]
    if any(term in text for term in profile_lock_terms):
        return "browser profile already open"
    return "live browser error"


async def drive_live(args):
    paths = live_paths()
    if not os.path.exists(paths["login_marker"]):
        return await afallback("login required")
    request_text = ""
    if not args.extract_only:
        # 送信モードのみ request が必要。extract-only(recover) は不要。
        if not args.request_file:
            sys.stderr.write("[pro-review-browser-drive] --request-file is required in live mode\n")
            return 2
        try:
            with open(args.request_file, "r", encoding="utf-8") as f:
                request_text = f.read()
        except OSError as exc:
            sys.stderr.write(f"[pro-review-browser-drive] cannot read request file: {exc}\n")
            return 2
    if not ensure_live_python():
        return await afallback("nodriver unavailable")
    import nodriver

    chrome = find_chrome()
    if not chrome:
        return await afallback("chrome unavailable")
    browser = None
    try:
        browser = await nodriver.start(
            user_data_dir=paths["profile"],
            browser_executable_path=chrome,
            headless=False,
            browser_args=["--disable-notifications"],
        )
        page = await browser.get("https://chatgpt.com/")
        _ARTIFACT_RUNTIME["page"] = page
        await page.sleep(2)
        if args.extract_only:
            # recover 用: 送信せず、開いている会話の最終回答だけ取得する。
            reply, reason, state = await extract_live_reply(
                page, args.run_id, args.timeout, request_file=args.request_file
            )
            if reply is None:
                reopen_url = resolve_reopen_conversation_url(args.run_id)
                if reopen_url:
                    reopen_url = validate_conversation_url(reopen_url)
                    if reopen_url:
                        sys.stderr.write(
                            f"[pro-review-browser-drive] reopening conversation: {reopen_url}\n"
                        )
                        page = await browser.get(reopen_url)
                        _ARTIFACT_RUNTIME["page"] = page
                        await page.sleep(2)
                        reply, reason, state = await extract_live_reply(
                            page, args.run_id, args.timeout, request_file=args.request_file
                        )
            if reply is None:
                return await afallback(reason, state)
            print(reply)
            return 0
        selector, editor = await wait_for_chat_input(page, min(args.timeout, 30))
        if not editor:
            content = await page.get_content()
            parser = AssistantParser()
            parser.feed(content)
            state = state_from_parser(parser)
            if parser.login_required:
                return await afallback("login required", state)
            return await afallback("composer not found", state)
        if args.mode == "connector":
            chat_selected, chat_detail = await select_chat_surface(page)
            sys.stderr.write(
                "[pro-review-browser-drive] Chat surface: "
                f"{'selected' if chat_selected else 'not-selected'}; {chat_detail}\n"
            )
            if not chat_selected:
                await save_diagnostic_artifacts_async()
                return await afallback(
                    f"Chat surface could not be selected: {chat_detail}"
                )
            selector, editor = await wait_for_chat_input(page, min(args.timeout, 30))
            if not editor:
                return await afallback("composer not found after Chat selection")
            await clear_prompt(page)
            selected, detail = await select_connector_mode(
                page, args.connector_label, min(args.timeout, 30)
            )
            if not selected:
                sys.stderr.write(
                    "[pro-review-browser-drive] connector selection failed: "
                    f"{args.connector_label}; {detail}\n"
                )
                await save_diagnostic_artifacts_async()
                return connector_unavailable(args.connector_label, detail)
            sys.stderr.write(
                "[pro-review-browser-drive] connector selected: "
                f"{args.connector_label}; {detail}\n"
            )
            selector, editor = await wait_for_chat_input(page, min(args.timeout, 30))
            if not editor:
                return await afallback("composer not found after connector selection")
        else:
            if args.thinking_level != "off":
                tl_ok, tl_detail = await select_thinking_level(page, args.thinking_level)
                if not tl_ok:
                    sys.stderr.write(
                        "[pro-review-browser-drive] thinking level selection failed: "
                        f"{args.thinking_level}; {tl_detail}\n"
                    )
                    await save_diagnostic_artifacts_async()
                    return await afallback(
                        f"thinking level unavailable: {tl_detail}"
                    )
                sys.stderr.write(
                    "[pro-review-browser-drive] thinking level selected: "
                    f"{args.thinking_level}; {tl_detail}\n"
                )
                selector, editor = await wait_for_chat_input(page, min(args.timeout, 30))
                if not editor:
                    return await afallback("composer not found after thinking level selection")
            policy = args.deep_research
            if policy == "auto":
                policy = parse_deep_research_policy(request_text)
            select_deep_research, decision_reason = decide_deep_research_selection(policy, request_text)
            if select_deep_research:
                selected, detail = await select_deep_research_mode(page, min(args.timeout, 30))
                if not selected:
                    sys.stderr.write(
                        "[pro-review-browser-drive] deep research selection failed: "
                        f"{decision_reason}; {detail}\n"
                    )
                    return await afallback("deep research unavailable")
                sys.stderr.write(
                    "[pro-review-browser-drive] deep research selected: "
                    f"{decision_reason}; {detail}\n"
                )
                selector, editor = await wait_for_chat_input(page, min(args.timeout, 30))
                if not editor:
                    return await afallback("composer not found after deep research selection")
        # 8.2: packet はファイル添付を主経路にする。98KB を入力欄に直書きしない。
        # 添付できたら入力欄には短い指示文だけ入れる。添付不可なら直書きにフォールバック。
        attached = False
        connector_mode = args.mode == "connector"
        if not args.no_attach and args.request_file:
            ok_attach, detail = await attach_request_file(page, args.request_file)
            if ok_attach:
                attached = True
                sys.stderr.write(f"[pro-review-browser-drive] request attached: {detail}\n")
                instruction = compose_attach_instruction(
                    request_text, args.run_id, os.path.basename(args.request_file)
                )
                if connector_mode:
                    ok_write, write_detail = await fill_prompt_preserve_pill(
                        page, editor, instruction
                    )
                    if not ok_write:
                        return await afallback(
                            f"connector attach instruction failed: {write_detail}"
                        )
                else:
                    res = js_object(await fill_prompt(page, instruction)) or {}
                    if not res.get("ok"):
                        await editor.click()
                        await editor.send_keys(instruction)
                    verify = js_object(await js(page, PROMPT_LENGTH_JS)) or {}
                    if int(verify.get("length") or 0) < 8:
                        sys.stderr.write(
                            "[pro-review-browser-drive] attach instruction not confirmed in composer; "
                            "retrying send_keys\n"
                        )
                        await editor.click()
                        await editor.send_keys(instruction)
            else:
                sys.stderr.write(
                    f"[pro-review-browser-drive] attach failed ({detail}); "
                    "falling back to inline paste\n"
                )
        if not attached:
            if connector_mode:
                ok_write, write_detail = await fill_prompt_preserve_pill(
                    page, editor, request_text
                )
                if not ok_write:
                    return await afallback(f"connector prompt append failed: {write_detail}")
            else:
                # フォールバック: 直書き。fill_prompt の返り値は環境差で生 dict にならない
                # ことがあるため js_object で正規化する。注入が成功しているのに send_keys に
                # 落ちて 98KB を1文字ずつ打つのを避ける。
                result = js_object(await fill_prompt(page, request_text))
                if not (result and result.get("ok")):
                    verify = js_object(await js(page, PROMPT_LENGTH_JS)) or {}
                    filled = int(verify.get("length") or 0)
                    if filled < min(len(request_text), 64):
                        if len(request_text) <= SEND_KEYS_MAX_CHARS:
                            await editor.click()
                            await editor.send_keys(request_text)
                        else:
                            return await afallback("prompt injection failed (request too large to type)")
        ready, ready_reason = await wait_send_enabled(page, min(args.timeout, 60))
        if not ready:
            state = await read_browser_state(page)
            sys.stderr.write(
                f"[pro-review-browser-drive] send not ready: {ready_reason}\n"
            )
            return await afallback(f"send not ready: {ready_reason}", state)
        sent_ok, sent_reason = await click_send(page, 20)
        if not sent_ok:
            state = await read_browser_state(page)
            sys.stderr.write(f"[pro-review-browser-drive] send not confirmed: {sent_reason}\n")
            return await afallback(f"send not confirmed: {sent_reason}", state)
        saved_url = None
        page_url = await wait_conversation_url(page, 20)
        if page_url:
            saved_url = persist_conversation_url(args.run_id, page_url)
            if saved_url:
                sys.stderr.write(
                    f"[pro-review-browser-drive] conversation url saved: {page_url}\n"
                )
        if args.send_only:
            print("sent: connector" if args.mode == "connector" else "sent: direct")
            if args.mode == "connector":
                print(f"connector_label: {args.connector_label}")
            return 0
        reply, reason, state = await extract_live_reply(
            page, args.run_id, args.timeout, request_file=args.request_file
        )
        if reply is None:
            return await afallback(reason, state)
        if not saved_url:
            page_url = await current_page_url(page)
            if is_conversation_url(page_url):
                saved_url = persist_conversation_url(args.run_id, page_url)
                if saved_url:
                    sys.stderr.write(
                        f"[pro-review-browser-drive] conversation url saved: {page_url}\n"
                    )
        print(reply)
        return 0
    except Exception as exc:
        sys.stderr.write(f"[pro-review-browser-drive] live error: {exc}\n")
        return await afallback(classify_live_error(exc))
    finally:
        if browser is not None:
            try:
                browser.stop()
            except Exception:
                pass


def main():
    ap = argparse.ArgumentParser(description="Drive ChatGPT browser and extract the final assistant reply.")
    ap.add_argument("--fixture-html", help="static HTML fixture to parse instead of live browser")
    ap.add_argument("--run-id", required=True, help="expected run id for [[DONE-<run_id>]]")
    ap.add_argument("--request-file", help="request markdown to send in live mode")
    ap.add_argument("--mode", choices=BROWSER_MODE_CHOICES, default="direct",
                    help="direct extracts DOM reply; connector selects a ChatGPT connector and sends")
    ap.add_argument("--connector-label", default=os.environ.get("PRO_REVIEW_CONNECTOR_LABEL", DEFAULT_CONNECTOR_LABEL),
                    help="visible ChatGPT connector label to select in connector mode")
    ap.add_argument("--send-only", action="store_true",
                    help="return after sending instead of waiting for a DOM reply")
    ap.add_argument("--deep-research", choices=TOOL_POLICY_CHOICES, default="auto",
                    help="select Deep Research in ChatGPT UI before sending: auto|on|off")
    ap.add_argument("--thinking-level", choices=THINKING_LEVEL_CHOICES,
                    default=os.environ.get("PRO_REVIEW_THINKING_LEVEL", "off"),
                    help="送信前に ChatGPT UI の思考レベルを選択する (off で無効。旧 Pro 相当は ウルトラ)")
    ap.add_argument("--timeout", type=float, default=600.0)
    ap.add_argument("--extract-only", action="store_true",
                    help="送信せず、開いている会話の最終回答だけ取得する (recover 用)")
    ap.add_argument("--no-attach", action="store_true",
                    help="ファイル添付を使わず入力欄に直書きする (フォールバック経路)")
    ap.add_argument("--fixture-reply",
                    help="copy 取得をモックした reply 本文ファイル (fixture)")
    ap.add_argument("--artifact-dir",
                    help="save diagnostic artifacts (dom-excerpt.html, screenshot.png) on fallback/timeout")
    args = ap.parse_args()

    if not validate_run_id(args.run_id):
        sys.stderr.write(
            f"[pro-review-browser-drive] error: invalid run_id: {args.run_id!r}"
            f" (must match {RUN_ID_RE.pattern}, not . or .., not start with '-' or '.')\n"
        )
        return 2

    configure_artifact_runtime(args)

    if args.fixture_reply:
        return extract_from_reply_file(args.fixture_reply, args.run_id)
    if args.fixture_html and args.mode == "connector":
        return fixture_connector_send(args.fixture_html, args.connector_label)
    if args.fixture_html:
        return extract_from_html(args.fixture_html, args.run_id)

    return asyncio.run(drive_live(args))


if __name__ == "__main__":
    sys.exit(main())
