#!/usr/bin/env python3
"""Drive/extract ChatGPT browser replies.

Fixture mode is implemented first and used by CI:
  pro-review-browser-drive --fixture-html page.html --run-id <run_id>

Live mode drives a dedicated ChatGPT browser profile when setup is present:
  exit 3 with FALLBACK:<reason>
"""
