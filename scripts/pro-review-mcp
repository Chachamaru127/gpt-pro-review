#!/usr/bin/env bash
# tunnel-client から起動される MCP コマンドのエントリポイント。
#
# 重要: ChatGPT の **GPT-5.5 Pro は Deep Research surface** で、`search` と `fetch`
# の 2 ツールしか呼ばない（公式: deep research models doesn't support tool calls or
# MCP servers that don't implement this interface）。一方 Thinking 系は普通の MCP
# ツールを呼べる。Pro でも Thinking でも動かすため、**search/fetch を実装した
# 専用 MCP**（pro-review-mcp-search-fetch）を既定にする。
#
# モード切替:
#   既定                … search/fetch 専用 MCP（Pro/Thinking 両対応・read-only）
#   PRO_REVIEW_FULL=1   … filesystem MCP を素のまま公開（Business/Enterprise/Edu のみ）
#
# 退役: PRO_REVIEW_MODE=readonly は廃止。filesystem MCP の read 系プロキシは
#       search/fetch だけで Thinking も動くため不要と判断（2026-06-22 合議）。
#       旧実装は scripts/_archive/pro-review-mcp-readonly に残す。
#
# 公開範囲: active-project の workspace（読）。ライブ repo は晒さない。
set -euo pipefail
SK="$HOME/.claude/skills/gpt-pro-review/scripts"
WS_BASE="$HOME/.pro-review/workspace"
INBOX_BASE="$HOME/.pro-review/inbox"
ACTIVE="$HOME/.pro-review/active-project"
FS_PKG="@modelcontextprotocol/server-filesystem@2026.1.14"

if [ -f "$ACTIVE" ] && [ -s "$ACTIVE" ]; then
  P="$(tr -d '[:space:]' < "$ACTIVE")"
  WS="$WS_BASE/$P"
  INBOX="$INBOX_BASE/$P"
else
  WS="$HOME/.pro-review/_no-project"
  INBOX="$WS"
fi
mkdir -p "$WS" "$INBOX"

if [ "${PRO_REVIEW_FULL:-}" = "1" ]; then
  # Business/Ent 専用: write 込みで素通し（ChatGPT が inbox に直接書ける旧フロー）
  exec npx -y "$FS_PKG" "$WS" "$INBOX"
else
  # 既定: search/fetch 専用 MCP（Pro 互換・Thinking 互換・read-only）
  exec "$SK/pro-review-mcp-search-fetch"
fi
