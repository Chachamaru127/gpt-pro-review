#!/usr/bin/env bash
# tunnel-client から起動される MCP コマンドのエントリポイント。
#
# 重要: 既定では汎用 filesystem write/edit/bash を公開しない。
# ChatGPT には workspace を読む search/fetch と、レビュー結果だけを保存する
# bounded save_report を公開する。
#
# モード切替:
#   既定                … search/fetch/save_report 専用 MCP
#   PRO_REVIEW_FULL=1   … filesystem MCP を素のまま公開（明示 Risk Gate 用）
#
# 退役: PRO_REVIEW_MODE=readonly は廃止。filesystem MCP の read 系プロキシは
#       search/fetch だけで Thinking も動くため不要と判断（2026-06-22 合議）。
#       旧実装は scripts/_archive/pro-review-mcp-readonly に残す。
#
# 公開範囲: active-project の workspace（読）と inbox（save_report のみ）。
# ライブ repo は晒さない。
set -euo pipefail
SK="$(cd "$(dirname "$0")" && pwd -P)"
WS_BASE="$HOME/.pro-review/workspace"
INBOX_BASE="$HOME/.pro-review/inbox"
ACTIVE="$HOME/.pro-review/active-project"
FS_PKG="@modelcontextprotocol/server-filesystem@2026.1.14"

if [ -f "$ACTIVE" ] && [ -s "$ACTIVE" ]; then
  P="$(tr -d '[:space:]' < "$ACTIVE")"
  WS="$WS_BASE/$P"
  INBOX="$INBOX_BASE/$P"
else
  WS="$HOME/.pro-review/_no-project"
  INBOX="$WS"
fi
mkdir -p "$WS" "$INBOX"

if [ "${PRO_REVIEW_FULL:-}" = "1" ]; then
  if [ "${PRO_REVIEW_FULL_CONFIRM:-}" != "I_UNDERSTAND_PRO_REVIEW_FULL" ]; then
    echo "[error] PRO_REVIEW_FULL=1 は汎用 filesystem write/edit を公開する Risk Gate です。" >&2
    echo "[error] 続行するには PRO_REVIEW_FULL_CONFIRM=I_UNDERSTAND_PRO_REVIEW_FULL を明示してください。" >&2
    exit 2
  fi
  if [ "${PRO_REVIEW_FULL_DRY_RUN:-}" = "1" ]; then
    echo "would_exec: npx -y $FS_PKG $WS $INBOX"
    exit 0
  fi
  # 明示 Risk Gate 用: filesystem MCP を素通し。
  exec npx -y "$FS_PKG" "$WS" "$INBOX"
else
  # 既定: search/fetch/save_report 専用 MCP。
  exec "$SK/pro-review-mcp-search-fetch"
fi
