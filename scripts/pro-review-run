#!/usr/bin/env bash
# レビュー1回分のライフサイクル管理:
#   開始時だけアクセスを開き(=デーモン起動, 対象プロジェクトのみ公開)、
#   結果を検知したら必ず閉じる(=デーモン停止, active-project解除)。
# これにより「使っている間だけ・そのプロジェクトだけ」露出する。
#
# 使い方:
#   pro-review-run --pro --repo <repo> [--project name] [--question "..."] [--fixture-html page.html]
#     [--web-search auto|on|off] [--deep-research auto|on|off]
#   pro-review-run --thinking --repo <repo> [--project name] [--question "..."]
#     [--timeout sec] [--drive-timeout sec] [--connector-label "..."] [--fixture-html page.html]
#   pro-review-run <repo> [project] [--question "観点"] [--timeout 秒]   # legacy
# 注意: デーモンは OpenAI へ outbound 接続する。実行はユーザーのシェルで。
set -euo pipefail
umask 077

SK_DIR="$(cd "$(dirname "$0")" && pwd -P)"

if printf '%s\n' "$@" | grep -qE '^--(pro|thinking|repo|project|fixture-html)$'; then
  MODE=""
  REPO=""
  PROJECT=""
	  QUESTION=""
	  FIXTURE_HTML=""
	  TIMEOUT=""
	  DRIVE_TIMEOUT=""
	  CONNECTOR_LABEL=""
	  WEB_SEARCH="auto"
	  DEEP_RESEARCH="auto"
	  TOOL_POLICY_EXPLICIT=0
  while [ "${1:-}" ]; do
    case "$1" in
      --pro) MODE="pro"; shift;;
      --thinking) MODE="thinking"; shift;;
      --repo) REPO="${2:-}"; shift 2;;
      --project) PROJECT="${2:-}"; shift 2;;
	      --question) QUESTION="${2:-}"; shift 2;;
	      --fixture-html) FIXTURE_HTML="${2:-}"; shift 2;;
	      --timeout) TIMEOUT="${2:-}"; shift 2;;
	      --drive-timeout) DRIVE_TIMEOUT="${2:-}"; shift 2;;
	      --connector-label) CONNECTOR_LABEL="${2:-}"; shift 2;;
	      --web-search) WEB_SEARCH="${2:-}"; TOOL_POLICY_EXPLICIT=1; shift 2;;
	      --deep-research) DEEP_RESEARCH="${2:-}"; TOOL_POLICY_EXPLICIT=1; shift 2;;
	      *) echo "usage: pro-review-run --pro|--thinking --repo <repo> [--project name] [--question ...] [--web-search auto|on|off] [--deep-research auto|on|off] [--timeout sec] [--drive-timeout sec] [--connector-label label]" >&2; exit 2;;
    esac
  done
  [ -n "$MODE" ] || { echo "[error] --pro or --thinking is required" >&2; exit 2; }
  [ -n "$REPO" ] || { echo "[error] --repo is required" >&2; exit 2; }
  if [ "$MODE" = "pro" ]; then
	    ARGS=("$REPO")
	    [ -n "$PROJECT" ] && ARGS+=("$PROJECT")
	    [ -n "$QUESTION" ] && ARGS+=(--question "$QUESTION")
	    [ -n "$FIXTURE_HTML" ] && ARGS+=(--fixture-html "$FIXTURE_HTML")
	    [ -n "$TIMEOUT" ] && ARGS+=(--timeout "$TIMEOUT")
	    ARGS+=(--web-search "$WEB_SEARCH" --deep-research "$DEEP_RESEARCH")
	    exec "$SK_DIR/pro-review-browser-run" "${ARGS[@]}"
	  fi
  if [ "$MODE" = "thinking" ]; then
    if [ "$TOOL_POLICY_EXPLICIT" = "1" ]; then
      echo "[error] --web-search/--deep-research are Path A (--pro) options" >&2
      exit 2
    fi
	    ARGS=("$REPO")
	    [ -n "$PROJECT" ] && ARGS+=("$PROJECT")
	    [ -n "$QUESTION" ] && ARGS+=(--question "$QUESTION")
	    [ -n "$FIXTURE_HTML" ] && ARGS+=(--fixture-html "$FIXTURE_HTML")
	    [ -n "$TIMEOUT" ] && ARGS+=(--timeout "$TIMEOUT")
	    [ -n "$DRIVE_TIMEOUT" ] && ARGS+=(--drive-timeout "$DRIVE_TIMEOUT")
	    [ -n "$CONNECTOR_LABEL" ] && ARGS+=(--connector-label "$CONNECTOR_LABEL")
	    exec "$SK_DIR/pro-review-connector-run" "${ARGS[@]}"
	  fi
fi

REPO="${1:?usage: pro-review-run <repo> [project] [--question ...]}"; shift
PROJECT=""
QUESTION=""
TIMEOUT="${TIMEOUT:-3600}"
if [ "${1:-}" ] && [ "${1#--}" = "$1" ]; then PROJECT="$1"; shift; fi
while [ "${1:-}" ]; do
  case "$1" in
    --question) QUESTION="${2:-}"; shift 2;;
    --timeout)  TIMEOUT="${2:-3600}"; shift 2;;
    *) shift;;
  esac
done

SK="${PRO_REVIEW_SCRIPTS_DIR:-$HOME/.claude/skills/gpt-pro-review/scripts}"
BASE="$HOME/.pro-review"
mkdir -p "$BASE"
chmod 700 "$BASE" 2>/dev/null || true

# 1. snapshot（.git/秘密情報除外。プロジェクト別サブフォルダへ）
SNAP=$("$SK/pro-review-snapshot" "$REPO" ${PROJECT:+"$PROJECT"})
echo "$SNAP"
# 機械読み取り専用行から取得（人間向け表示から parse しない）
PROJECT=$(printf '%s\n' "$SNAP" | awk '/^project_name:/{print $2; exit}')
if ! printf '%s' "$PROJECT" | grep -qE '^[A-Za-z0-9._-]+$'; then
  echo "[error] project名の取得/検証に失敗: '$PROJECT'" >&2; exit 1
fi
INBOX="$BASE/inbox/$PROJECT"

# 2. このプロジェクトだけ公開に絞る
printf '%s\n' "$PROJECT" > "$BASE/active-project"

# 3. アクセスを開く前に、終了時の遮断を必ず仕込む（Ctrl-C/異常終了でも閉じる）
cleanup() {
  kill "${DPID:-}" 2>/dev/null || true
  pkill -f 'tunnel-client run --profile pro-review' 2>/dev/null || true
  : > "$BASE/active-project"
  echo "[closed] アクセス遮断: デーモン停止 + active-project 解除" >&2
}
trap cleanup EXIT INT TERM

# 既存デーモンがいたら lifecycle 管理のため停止して握り直す
if pgrep -f 'tunnel-client run --profile pro-review' >/dev/null 2>&1; then
  echo "[info] 既存デーモンを停止して握り直します" >&2
  pkill -f 'tunnel-client run --profile pro-review' 2>/dev/null || true
  sleep 1
fi

# 4. デーモン起動（このプロジェクトだけ公開された状態で）
("$SK/pro-review-tunnel" 2>&1 | "$SK/pro-review-redact-log" > "$BASE/daemon.log") &
DPID=$!
chmod 600 "$BASE/daemon.log" 2>/dev/null || true
sleep 3
if ! kill -0 "$DPID" 2>/dev/null; then
  echo "[error] デーモン起動失敗。$BASE/daemon.log を確認:" >&2
  tail -5 "$BASE/daemon.log" | "$SK/pro-review-redact-log" >&2
  exit 1
fi
echo "[open] アクセス開始: project=$PROJECT のみ公開、デーモン PID=$DPID"

# 5. 貼り付け用の依頼文を生成（legacy connector モード + save_report 書き戻し指示）
START=$(date +%s)
RUN_ID="$("$SK/pro-review-gen-run-id")"
mkdir -p "$BASE/outbox"
REQ="$BASE/outbox/${PROJECT}-legacy-${RUN_ID}.md"
REPLY_REL="inbox/$PROJECT/REPLY-${RUN_ID}.md"
cat > "$REQ" <<EOF
あなたは接続済みの pro-review コネクタで、プロジェクト workspace にアクセスできます（このレビュー中のみ有効）。コネクタは 3 つのツールを提供します:
- search(query): workspace 内のファイルを検索。query="" または "*" で全件一覧。
- fetch(id): search が返した id（workspace 相対パス）を渡して全文を取得。
- save_report(project, run_id, body): 最終レビュー結果だけをローカル inbox に保存。

project: ${PROJECT}
run_id: ${RUN_ID}
保存先ID: ${REPLY_REL}

送信前チェック:
- ChatGPT 側で Developer Mode を有効化していること。
- このチャットで pro-review Tunnel connector（同じ tunnel_id）を有効化していること。
- search/fetch/save_report が表示・実行できない場合は、本文を推測せず STOP_REASON=connector_unavailable と NEXT_ACTION=ChatGPT側でpro-review Tunnel connectorを有効化 を返すこと。

タスク:
1) search("") で workspace 全ファイル一覧を取得し、構造を把握する。
2) 必要なファイルを fetch(id) で読む。
3) 次の観点でレビュー: ${QUESTION:-正しさ(バグ/論理破綻)・セキュリティ・設計の妥当性・抜けているエッジケース。各指摘は file:line と 重大度(高/中/低)}
4) 回答本文の最終行に "[[DONE-${RUN_ID}]]" を必ず記載する（自動検知用）。
5) 完成した回答本文を save_report(project="${PROJECT}", run_id="${RUN_ID}", body=<回答全文>) で保存する。
6) search/fetch が使えない場合はレビューせず STOP_REASON=connector_unavailable と NEXT_ACTION=ChatGPT側でpro-review Tunnel connectorを有効化 を出力する。
7) search/fetch は使えるが save_report だけ使えない場合のみ、このチャット本文に回答全文を出力する。
EOF
echo "run_id: $RUN_ID"
echo "================ ChatGPT(non-5.5Pro + Tunnel connector)に貼る依頼 ================"
cat "$REQ"
echo "==============================================================="
command -v pbcopy >/dev/null 2>&1 && pbcopy < "$REQ" && echo "(↑クリップボードにコピー済み。ChatGPTに貼ってください)"

# 6. 結果を待つ（検知 or timeout で抜ける → trap が必ずアクセス遮断）
echo "[waiting] $INBOX を監視中… (最大 ${TIMEOUT}s)"
if WOUT="$("$SK/pro-review-watch" "$INBOX" --run-id "$RUN_ID" --since "$((START - 1))" --timeout "$TIMEOUT" --interval 3)"; then
  echo "$WOUT"
  # 返信を reports/ に永続化（後から参照できるように）
  REPLY=$(printf '%s\n' "$WOUT" | awk '/^REPLY:/{print $2; exit}')
  if [ -n "$REPLY" ] && [ -f "$REPLY" ]; then
    REPORTS="$BASE/reports/$PROJECT"; mkdir -p "$REPORTS"; chmod 700 "$REPORTS" 2>/dev/null || true
    TS=$(date +%Y%m%d-%H%M%S); DEST="$REPORTS/$TS-$(basename "$REPLY")"
    cp "$REPLY" "$DEST" && chmod 600 "$DEST" 2>/dev/null || true && echo "report_saved: $DEST"
  fi
  echo "[done] レビュー受領。アクセスを閉じます。"
else
  echo "[timeout] 期限内に結果が来ませんでした。アクセスを閉じます。" >&2
fi
# trap cleanup がここで発火（デーモン停止・公開解除）
