#!/usr/bin/env python3
"""Read-only ChatGPT selector probe for pro-review-doctor --selector-check."""
import asyncio
import importlib.machinery
import json
import os
import sys
from collections.abc import Mapping
from datetime import date


def line(level, key, message):
    print(f"{level}\t{key}\t{message}", flush=True)


def manual(reason):
    line("MANUAL", "selector_check", reason)


def load_drive_module(path):
    return importlib.machinery.SourceFileLoader(
        "pro_review_browser_drive_selector_check", path
    ).load_module()


def collect_selector_entries(module):
    entries = []
    for name in sorted(dir(module)):
        if not (name.endswith("_SELECTOR") or name.endswith("_SELECTORS")):
            continue
        if name.startswith("_"):
            continue
        val = getattr(module, name)
        if isinstance(val, str) and val.strip():
            entries.append((name, val))
        elif isinstance(val, list):
            for i, item in enumerate(val):
                if isinstance(item, str) and item.strip():
                    entries.append((f"{name}[{i}]", item))
    return entries


def build_selector_check_js(entries):
    payload = [[name, sel] for name, sel in entries]
    return f"""(() => {{
  const items = {json.dumps(payload)};
  return items.map(([name, sel]) => {{
    let found = false;
    try {{
      found = document.querySelector(sel) !== null;
    }} catch (_e) {{
      found = false;
    }}
    return {{ name, found }};
  }});
}})()"""


def print_checklist(total, found, missing_items, unresolved):
    print("## selector-check (doctor --selector-check)", flush=True)
    print("", flush=True)
    print(f"- date: {date.today().isoformat()}", flush=True)
    print(f"- checked: {total} selectors, {found} found, {len(missing_items)} missing", flush=True)
    print("- missing:", flush=True)
    if missing_items:
        for name, sel in missing_items:
            print(f"  - {name}: {sel}", flush=True)
    else:
        print("  - (none)", flush=True)
    print("- unresolved:", flush=True)
    if unresolved:
        print(f"  - {unresolved}", flush=True)
    else:
        print("  - (none)", flush=True)


def report_results(entries, results):
    entry_map = {name: sel for name, sel in entries}
    found_count = 0
    missing_items = []
    for item in results:
        name = str(item.get("name", ""))
        is_found = bool(item.get("found"))
        key = f"selector:{name}"
        if is_found:
            found_count += 1
            line("OK", key, "found")
        else:
            line("WARN", key, "missing")
            missing_items.append((name, entry_map.get(name, "?")))
    print_checklist(len(entries), found_count, missing_items, "")
    return 0


async def check_live(module, entries):
    paths = module.live_paths()
    if not os.path.exists(paths["login_marker"]):
        manual(
            "login marker missing; run pro-review-browser-setup --open-login "
            "then --mark-logged-in"
        )
        print_checklist(len(entries), 0, entries, "login marker missing")
        return 0

    if not os.path.exists(paths["venv_python"]):
        manual("browser venv missing; run pro-review-browser-setup --install")
        print_checklist(len(entries), 0, entries, "venv missing")
        return 0

    try:
        import nodriver  # noqa: F401
    except Exception:
        manual("nodriver not importable; run pro-review-browser-setup --install")
        print_checklist(len(entries), 0, entries, "nodriver unavailable")
        return 0

    chrome = module.find_chrome()
    if not chrome:
        manual("Chrome not found; set PRO_REVIEW_CHROME or install Google Chrome")
        print_checklist(len(entries), 0, entries, "chrome unavailable")
        return 0

    browser = None
    try:
        browser = await nodriver.start(
            user_data_dir=paths["profile"],
            browser_executable_path=chrome,
            headless=False,
            browser_args=["--disable-notifications"],
        )
        page = await browser.get("https://chatgpt.com/")
        await page.sleep(2)

        login_present = await module.js(
            page,
            'document.querySelector(\'[data-testid="login-button"], '
            'button[data-testid="login-button"]\') !== null',
        )
        if login_present:
            manual(
                "ChatGPT login required; run pro-review-browser-setup --open-login"
            )
            print_checklist(len(entries), 0, entries, "login required on page")
            return 0

        js_expr = build_selector_check_js(entries)
        raw = await module.js(page, js_expr)
        parsed = module.js_object(raw)
        if not isinstance(parsed, list):
            manual("selector evaluation failed; page may not have loaded")
            print_checklist(len(entries), 0, entries, "evaluation failed")
            return 0

        normalized = []
        for item in parsed:
            if isinstance(item, Mapping):
                normalized.append(dict(item))
            else:
                normalized.append({"name": str(item), "found": False})
        return report_results(entries, normalized)
    except Exception as exc:
        reason = module.classify_live_error(exc)
        if reason == "browser profile already open":
            manual("browser profile already open; close dedicated Chrome and retry")
            unresolved = "browser profile already open"
        else:
            manual(f"page reach failed: {exc}")
            unresolved = str(exc)
        print_checklist(len(entries), 0, entries, unresolved)
        return 0
    finally:
        if browser is not None:
            try:
                browser.stop()
            except Exception:
                pass


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) != 1:
        print(
            "usage: pro-review-doctor-selector-check <path-to-pro-review-browser-drive>",
            file=sys.stderr,
        )
        return 2

    drive_path = os.path.abspath(argv[0])
    if not os.path.isfile(drive_path):
        manual(f"browser-drive not found: {drive_path}")
        print_checklist(0, 0, [], "browser-drive missing")
        return 0

    module = load_drive_module(drive_path)
    entries = collect_selector_entries(module)
    if not entries:
        manual("no selector constants found in browser-drive")
        print_checklist(0, 0, [], "no selectors")
        return 0

    return asyncio.run(check_live(module, entries))


if __name__ == "__main__":
    sys.exit(main())
