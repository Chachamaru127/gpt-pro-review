#!/usr/bin/env bash
# Diagnose local gpt-pro-review setup without printing secrets.
set -euo pipefail

SELECTOR_CHECK=0
for arg in "$@"; do
  [ "$arg" = "--selector-check" ] && SELECTOR_CHECK=1
done

SK="$(cd "$(dirname "$0")" && pwd -P)"
BASE="$HOME/.pro-review"
STATUS=0

line() {
  # line LEVEL KEY MESSAGE
  printf '%s\t%s\t%s\n' "$1" "$2" "$3"
}

need_fix() { STATUS=1; line "FIX" "$1" "$2"; }
manual() { line "MANUAL" "$1" "$2"; }
warn() { line "WARN" "$1" "$2"; }
ok() { line "OK" "$1" "$2"; }

mkdir -p "$BASE"
chmod 700 "$BASE" 2>/dev/null || true
MODE=$(stat -f '%Lp' "$BASE" 2>/dev/null || echo unknown)
[ "$MODE" = "700" ] && ok "base_mode" "$HOME/.pro-review is 700" || need_fix "base_mode" "$HOME/.pro-review should be 700"

missing=0
for s in \
  pro-review-browser-setup pro-review-browser-embed pro-review-browser-drive pro-review-browser-run \
  pro-review-mcp pro-review-mcp-search-fetch pro-review-save-reply \
  pro-review-watch pro-review-finish pro-review-summarize \
  pro-review-tunnel-check pro-review-redact-log pro-review-danger-mode \
  pro-review-recover; do
  if [ -x "$SK/$s" ]; then
    ok "script:$s" "executable"
  else
    missing=1
    need_fix "script:$s" "missing or not executable"
  fi
done

VENV="$BASE/browser/venv"
BROWSER_PY="$VENV/bin/python"
if [ -x "$BROWSER_PY" ] && "$BROWSER_PY" - <<'PY' >/dev/null 2>&1
import nodriver  # noqa: F401
PY
then
  ok "nodriver" "venv module importable"
elif python3 - <<'PY' >/dev/null 2>&1
import nodriver  # noqa: F401
PY
then
  ok "nodriver" "python module importable"
else
  manual "nodriver" "not installed; Path A live mode will use fallback"
fi

ND_VER=""
if [ -x "$BROWSER_PY" ]; then
  ND_VER=$("$BROWSER_PY" -c "import importlib.metadata as m; print(m.version('nodriver'))" 2>/dev/null || true)
fi
if [ -n "$ND_VER" ]; then
  ok "nodriver_version" "$ND_VER"
else
  manual "nodriver_version" "not installed"
fi

if command -v tunnel-client >/dev/null 2>&1 || [ -x "$BASE/bin/tunnel-client" ]; then
  ok "tunnel_client" "found"
else
  manual "tunnel_client" "not found; Path B live tunnel needs setup"
fi

ENVF="$BASE/env.sh"
if [ -f "$ENVF" ]; then
  PERM=$(stat -f '%Lp' "$ENVF" 2>/dev/null || echo unknown)
  [ "$PERM" = "600" ] && ok "env_file" "env.sh is 600" || need_fix "env_file" "env.sh should be 600"
  if grep -qE '^(export[[:space:]]+)?CONTROL_PLANE_TUNNEL_ID=' "$ENVF"; then
    ok "tunnel_id" "configured"
  elif grep -qE '^(export[[:space:]]+)?CONTROL_PLANE_TUNNEL_ID_[A-Z0-9]+=' "$ENVF"; then
    ok "tunnel_id" "configured (profile 形式)"
  else
    manual "tunnel_id" "missing"
  fi
  if grep -qE '^(export[[:space:]]+)?CONTROL_PLANE_API_KEY=' "$ENVF"; then
    ok "api_key" "configured"
  elif grep -qE '^(export[[:space:]]+)?CONTROL_PLANE_API_KEY_[A-Z0-9]+=' "$ENVF"; then
    ok "api_key" "configured (profile 形式)"
  else
    manual "api_key" "missing"
  fi
  profile_line=$(grep -E '^(export[[:space:]]+)?PRO_REVIEW_TUNNEL_PROFILE=' "$ENVF" 2>/dev/null | head -1 || true)
  if [ -n "$profile_line" ]; then
    profile_val="${profile_line#*=}"
    profile_val="${profile_val#export }"
    profile_val="${profile_val%\"}"
    profile_val="${profile_val#\"}"
    ok "tunnel_profile" "$profile_val"
  fi
else
  manual "env_file" "missing; create ~/.pro-review/env.sh with tunnel id and key"
fi

DANGER="$BASE/danger-mode"
if [ -f "$DANGER" ]; then
  warn "danger_mode" "ON — secret scan は bypass されます (この環境のみ; 解除: pro-review-danger-mode --off)"
else
  ok "danger_mode" "OFF — secret scan 有効 (既定)"
fi

REPORTS="$BASE/reports"
RUN_COUNT=0
PROJECT_COUNT=0
if [ -d "$REPORTS" ]; then
  for proj in "$REPORTS"/*; do
    [ -d "$proj" ] || continue
    PROJECT_COUNT=$((PROJECT_COUNT + 1))
    for run in "$proj"/*; do
      [ -d "$run" ] || continue
      RUN_COUNT=$((RUN_COUNT + 1))
    done
  done
fi
ok "run_count" "$RUN_COUNT runs across $PROJECT_COUNT projects (observation only)"

[ "$missing" -eq 0 ] || STATUS=1

if [ "$SELECTOR_CHECK" = "1" ]; then
  SELECTOR_PY="python3"
  if [ -x "$BROWSER_PY" ]; then
    SELECTOR_PY="$BROWSER_PY"
  fi
  "$SELECTOR_PY" "$SK/pro-review-doctor-selector-check" "$SK/pro-review-browser-drive" || true
fi

exit "$STATUS"
